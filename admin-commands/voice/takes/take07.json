{"id": "07", "model": "eleven_v4", "lines": [{"speaker": "NARRATOR", "text": "Out of the crack came... a chat message. [pause] The biggest chat message you've ever seen."}, {"speaker": "ADMIN", "text": "[booming] Who. Gave you. Admin?"}, {"speaker": "YOU", "text": "[tiny voice] ...A garage sale?"}, {"speaker": "ADMIN", "text": "[booming] You flew a bus. You jailed a child. You made one hundred thousand cats... GIANT."}, {"speaker": "ADMIN", "text": "[booming] Your log is longer... than my beard."}, {"speaker": "YOU", "text": "[nervous] In my defense... the cats look really happy."}, {"speaker": "ADMIN", "text": "[cold, booming] Un-fly. All."}, {"speaker": "NARRATOR", "text": "Everyone fell at the same time. [pause] Lucky for them... cats are VERY good at catching things."}, {"speaker": "ADMIN", "text": "[booming] And now... you. [pause] Kick."}, {"speaker": "YOU", "text": "[panicked] No no no\u2014 God mode! GOD MODE ME!"}, {"speaker": "ADMIN", "text": "[surprised, then angry] You... dare... use god mode... against an ADMIN?"}, {"speaker": "NARRATOR", "text": "[hushed] And that's how the first admin battle in history began."}], "voice_segments": [{"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 0.0, "end_time_seconds": 6.24, "character_start_index": 0, "character_end_index": 91, "dialogue_input_index": 0}, {"voice_id": "pqHfZKP75CvOlQylNhV4", "start_time_seconds": 6.24, "end_time_seconds": 9.44, "character_start_index": 91, "character_end_index": 122, "dialogue_input_index": 1}, {"voice_id": "TX3LPaxmHKxFdv7VOQHJ", "start_time_seconds": 9.44, "end_time_seconds": 11.280000000000001, "character_start_index": 122, "character_end_index": 152, "dialogue_input_index": 2}, {"voice_id": "pqHfZKP75CvOlQylNhV4", "start_time_seconds": 11.280000000000001, "end_time_seconds": 18.32, "character_start_index": 152, "character_end_index": 242, "dialogue_input_index": 3}, {"voice_id": "pqHfZKP75CvOlQylNhV4", "start_time_seconds": 18.32, "end_time_seconds": 21.92, "character