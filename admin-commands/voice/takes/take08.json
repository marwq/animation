{"id": "08", "model": "eleven_v4", "lines": [{"speaker": "ADMIN", "text": "[booming] Freeze."}, {"speaker": "NARRATOR", "text": "He froze you solid."}, {"speaker": "GRANNY", "text": "[very fast, cheerful] Hold still, sweetie! Granny's got a hair dryer!"}, {"speaker": "YOU", "text": "[teeth chattering] Th-thanks, Granny! Teleport... me... away!"}, {"speaker": "NARRATOR", "text": "You teleported to the desert. He was there. [pause] To the ocean. He was there. [pause] To the top of a mountain. [pause] He was there... with a snack."}, {"speaker": "ADMIN", "text": "[calm] Teleport is my command. [pause] I invented it."}, {"speaker": "YOU", "text": "[typing fast] Jail... Admin!"}, {"speaker": "ADMIN", "text": "[calm] Un-jail me. [pause] Jail YOU."}, {"speaker": "YOU", "text": "[frustrated] Un-jail me! [pause] Jail you! [pause] UN-JAIL ME!"}, {"speaker": "NARRATOR", "text": "[deadpan] This went on for eleven minutes."}, {"speaker": "YOU", "text": "[typing furiously] Fine! Size me... one hundred!"}, {"speaker": "ADMIN", "text": "[unimpressed] Size me... one thousand."}, {"speaker": "NARRATOR", "text": "[deadpan] He always had a bigger number."}, {"speaker": "DAD", "text": "[heroic] Nobody messes with my kid! [pause] Can you hear me now?!"}, {"speaker": "ADMIN", "text": "[annoyed, booming] Yes! I can hear you! Everybody can hear you!"}, {"speaker": "ZOE", "text": "[focused] I'm in his logs! He's not a program... he's a PERSON. He's typing from somewhere REAL!"}, {"speaker": "YOU", "text": "[determined] Then I'm going there. [pause] Teleport me... to the Admin!"}, {"speaker": "SYSTEM", "text": "[warning] Warning. Battery... three percent."}, {"speaker": "YOU", "text": "[shouting] TELEPORT ME TO THE ADMIN!"}], "voice_segments": [{"voice_id": "pqHfZKP75CvOlQylNhV4", "start_time_seconds": 0.0, "end_time_seconds": 1.28, "character_start_index": 0, "character_end_index": 17, "dialogue_input_index": 0}, {"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 1.28, "end_time_seco