{"id": "06", "model": "eleven_v4", "lines": [{"speaker": "NARRATOR", "text": "Saturday. You decide to think bigger."}, {"speaker": "YOU", "text": "[excited] Fly... ALL!"}, {"speaker": "NARRATOR", "text": "The whole town took off. Including the mailman. Including a bus. [pause] Including a guy who was in the bath."}, {"speaker": "NARRATOR", "text": "Then you wanted to make Pancake big again. Just a little. [pause] But you made a typo."}, {"speaker": "SYSTEM", "text": "[calm] Command: size... all cats. One hundred."}, {"speaker": "NARRATOR", "text": "[stunned] Every cat in the city. [pause] One hundred times bigger."}, {"speaker": "YOU", "text": "[laughing, drunk on power] I'm the king of the city! [pause] I'm the ADMIN OF EVERYTHING!"}, {"speaker": "ZOE", "text": "[alarmed] Your log is nine thousand lines long! Somebody is DEFINITELY reading it!"}, {"speaker": "ANCHOR", "text": "[dramatic] Breaking news! The city is flying! Grandmas are breaking the sound barrier! And a giant cat is sitting... on the mayor."}, {"speaker": "ANCHOR", "text": "[worried] Experts are asking one question. [pause] Who is doing this?"}, {"speaker": "YOU", "text": "[nervous, typing fast] Okay! I'll fix it! Un-fly all! Size all cats... one!"}, {"speaker": "SYSTEM", "text": "[cold] Permission denied. [pause] Permission denied. [pause] Your admin rights... are under review."}, {"speaker": "NARRATOR", "text": "[hushed] And that's when the sky... cracked."}], "voice_segments": [{"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 0.0, "end_time_seconds": 3.04, "character_start_index": 0, "character_end_index": 37, "dialogue_input_index": 0}, {"voice_id": "TX3LPaxmHKxFdv7VOQHJ", "start_time_seconds": 3.04, "end_time_seconds": 5.12, "character_start_index": 37, "character_end_index": 58, "dialogue_input_index": 1}, {"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 5.12, "end_time_seconds": 12.8, "character_start_index": 58, "character_end_index": 167, "dialogue_input_index": 2}, {"voi