{"id": "03", "model": "eleven_v4", "lines": [{"speaker": "ANCHOR", "text": "[breaking news, urgent] Breaking news! Starting today, Robux are officially REAL money!"}, {"speaker": "ANCHOR", "text": "One Robux equals one dollar. Effective... right now!"}, {"speaker": "TY", "text": "[stunned whisper] One Robux... one dollar. [pause] Three million Robux..."}, {"speaker": "TY", "text": "[screams with joy] I'M A MILLIONAIRE!"}, {"speaker": "ANCHOR", "text": "[excited] Across the world, gamers are celebrating! Parents are confused! And one man just found forty thousand Robux in his son's old tablet!"}, {"speaker": "TY", "text": "[fast, laughing] Kids became richer than their parents overnight. My neighbor's six-year-old bought the ice cream truck. [pause] The whole truck."}, {"speaker": "MIA", "text": "[horrified] Wait. Then my hats... Can I SELL my hats?!"}, {"speaker": "SYSTEM", "text": "[cheerful UI voice] Sorry! All sales are final. No refunds!"}, {"speaker": "MIA", "text": "[screams] NOOOOO!"}, {"speaker": "DAD", "text": "[confused] Kids? Why is the ceiling raining money?"}, {"speaker": "TY", "text": "[fast, narrating] Dad never played Roblox in his life. Zero Robux. Mom had five, from a gift card in 2019."}, {"speaker": "MOM", "text": "[calm, pleased] Five dollars. [pause] I'll take it."}, {"speaker": "GRANDMA", "text": "[excited, old lady] Ooh! I've got eight hundred Robux from my obby tournaments!"}, {"speaker": "TY", "text": "Yeah. Grandma is better at Roblox than all of us."}], "voice_segments": [{"voice_id": "onwK4e9ZLuTAKqWW03F9", "start_time_seconds": 0.0, "end_time_seconds": 4.96, "character_start_index": 0, "character_end_index": 87, "dialogue_input_index": 0}, {"voice_id": "onwK4e9ZLuTAKqWW03F9", "start_time_seconds": 4.96, "end_time_seconds": 9.28, "character_start_index": 87, "character_end_index": 139, "dialogue_input_index": 1}, {"voice_id": "bIHbv24MWmeRgasZH58o", "start_time_seconds": 9.28, "end_time_seconds": 14.8, "character_start_index": 139, "char