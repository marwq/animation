{"id": "07", "model": "eleven_v4", "lines": [{"speaker": "TY", "text": "[dramatic] But real money... brought real problems."}, {"speaker": "SCAMMER", "text": "[smooth, oily] Good evening, ma'am! FREE ROBUX! Just tell me your password, and I'll DOUBLE your Robux!"}, {"speaker": "GRANDMA", "text": "[delighted] Ooh, double! [pause] Well, my password is \"password\"..."}, {"speaker": "TY", "text": "[shouts] GRANDMA, NO!"}, {"speaker": "TY", "text": "[running, fast] I KNEW that guy! He's the \"free Robux\" scam from every game chat EVER!"}, {"speaker": "SCAMMER", "text": "[panicked] Free Robux! Free Robux! Click my link!"}, {"speaker": "TY", "text": "[dodging, fast] \"Robux generator, one hundred percent real!\" \"You won a free hat!\" \"Verify your account!\" [pause] Nope! Nope! NOPE!"}, {"speaker": "TY", "text": "[panting] If Robux are real money... then scamming is a REAL crime!"}, {"speaker": "SYSTEM", "text": "[booming] User reported. [pause] BANNED."}, {"speaker": "SCAMMER", "text": "[being dragged away] I'll be back! With a better link!"}, {"speaker": "GRANDMA", "text": "[sheepish] I just wanted a cool hat for my obby stream."}, {"speaker": "TY", "text": "[warm, firm] Grandma. Never. Share. Your password."}, {"speaker": "GRANDMA", "text": "[nods] Okay, sweetie. [pause] It's \"password two\" now."}, {"speaker": "TY", "text": "[facepalm] ...Grandma."}], "voice_segments": [{"voice_id": "bIHbv24MWmeRgasZH58o", "start_time_seconds": 0.0, "end_time_seconds": 3.08, "character_start_index": 0, "character_end_index": 51, "dialogue_input_index": 0}, {"voice_id": "cjVigY5qzO86Huf0OWal", "start_time_seconds": 3.08, "end_time_seconds": 8.56, "character_start_index": 51, "character_end_index": 154, "dialogue_input_index": 1}, {"voice_id": "pFZP5JQG7iQjIQuC4Bku", "start_time_seconds": 8.56, "end_time_seconds": 14.32, "character_start_index": 154, "character_end_index": 221, "dialogue_input_index": 2}, {"voice_id": "bIHbv24MWmeRgasZH58o", "start_time_seconds": 14.32, "end_time_se