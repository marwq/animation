{"id": "06b", "model": "eleven_v4", "lines": [{"speaker": "TY", "text": "[narrating] Meanwhile, Dad had a brilliant idea."}, {"speaker": "DAD", "text": "[dramatic] If playing games makes money now... I'm quitting my job. I'm going PRO."}, {"speaker": "TY", "text": "[fast] He bought an RGB gaming chair. An RGB headset. And RGB socks."}, {"speaker": "DAD", "text": "[focused, tense] Okay. Jump... jump... JUMP!"}, {"speaker": "SYSTEM", "text": "[chirpy] Oof! You died. Attempt three hundred and twelve."}, {"speaker": "DAD", "text": "[screams] The lava is RIGGED!"}, {"speaker": "TY", "text": "Dad was terrible. [pause] But Grandma..."}, {"speaker": "GRANDMA", "text": "[hyped, streamer voice] What's up, chat! NanaBea here! Speedrun, no jumps, eyes closed! Let's GO!"}, {"speaker": "TY", "text": "[impressed] Grandma was the most famous obby streamer in the world. Two million viewers. [pause] She made more in one stream than Dad made in a year."}, {"speaker": "DAD", "text": "[sulking] ...I'm going back to my job."}, {"speaker": "GRANDMA", "text": "[sweet] Bye, sweetie! Like and subscribe!"}], "voice_segments": [{"voice_id": "bIHbv24MWmeRgasZH58o", "start_time_seconds": 0.0, "end_time_seconds": 2.76, "character_start_index": 0, "character_end_index": 48, "dialogue_input_index": 0}, {"voice_id": "iP95p4xoKVk53GoZ742B", "start_time_seconds": 2.76, "end_time_seconds": 8.4, "character_start_index": 48, "character_end_index": 130, "dialogue_input_index": 1}, {"voice_id": "bIHbv24MWmeRgasZH58o", "start_time_seconds": 8.4, "end_time_seconds": 13.440000000000001, "character_start_index": 130, "character_end_index": 198, "dialogue_input_index": 2}, {"voice_id": "iP95p4xoKVk53GoZ742B", "start_time_seconds": 13.440000000000001, "end_time_seconds": 17.200000000000003, "character_start_index": 198, "character_end_index": 242, "dialogue_input_index": 3}, {"voice_id": "nPczCjzI2devNBz1zQrb", "start_time_seconds": 17.200000000000003, "end_time_seconds": 20.96, "character_start_index": 242, "ch