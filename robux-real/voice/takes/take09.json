{"id": "09", "model": "eleven_v4", "lines": [{"speaker": "MIA", "text": "[determined] Okay, losers. We've got a problem. [pause] Look at this."}, {"speaker": "MIA", "text": "The Robux Printer. Every daily reward in the world comes out of this one machine. And it's running at a thousand percent."}, {"speaker": "TY", "text": "[realizing] So if we turn it off... prices stop going up!"}, {"speaker": "PICKLE", "text": "[nervous] And the Thirty Percent Guy? He's been taking thirty percent of EVERYTHING."}, {"speaker": "TY", "text": "[grim] That's why he's the size of a building."}, {"speaker": "MIA", "text": "[smirks] So... who wants to rob a bank?"}, {"speaker": "TY", "text": "[determined] Technically, we're UN-robbing it. [pause] Let's go."}, {"speaker": "GRANDMA", "text": "[hyped] You need a distraction? Leave that to me, sweetie. [pause] Chat! We're going LIVE in front of the bank!"}, {"speaker": "DAD", "text": "[proud] And I'll drive the getaway car! [pause] Very carefully. Under the speed limit."}], "voice_segments": [{"voice_id": "FGY2WhTYpPnrIDTdsKH5", "start_time_seconds": 0.0, "end_time_seconds": 4.08, "character_start_index": 0, "character_end_index": 69, "dialogue_input_index": 0}, {"voice_id": "FGY2WhTYpPnrIDTdsKH5", "start_time_seconds": 4.08, "end_time_seconds": 12.08, "character_start_index": 69, "character_end_index": 190, "dialogue_input_index": 1}, {"voice_id": "bIHbv24MWmeRgasZH58o", "start_time_seconds": 12.08, "end_time_seconds": 16.0, "character_start_index": 190, "character_end_index": 247, "dialogue_input_index": 2}, {"voice_id": "cgSgspJ2msm6clMCkdW9", "start_time_seconds": 16.0, "end_time_seconds": 21.04, "character_start_index": 247, "character_end_index": 331, "dialogue_input_index": 3}, {"voice_id": "bIHbv24MWmeRgasZH58o", "start_time_seconds": 21.04, "end_time_seconds": 23.359999999999996, "character_start_index": 331, "character_end_index": 377, "dialogue_input_index": 4}, {"voice_id": "FGY2WhTYpPnrIDTdsKH5", "start_time_seconds": 23.359999