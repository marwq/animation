// SC 08 · РЕЙДЖ-КВИТ — the rage-quit, the bedroom talk, the 11 p.m. alarm.
// The living room at night: the family cracking up at their screens, each with their trophy popping out of the game (BEST
// FIGHTER / RICHEST PLAYER / EVERYONE'S FAVORITE); from behind the hero: "And you..." -> his monitor: the leaderboard rolls,
// YOU slides from #2 to #47, THE SON stamp; the monitor POV: his face boils -> SLAM (he slams the monitor down like a laptop
// lid); everyone turns; "This is MY game!" (the hero up, fists), "My friends! My server!" (the panels: Noodle HIRED, the
// DAD crowd TAKEN), "You're taking EVERYTHING!" (smash zoom); Mom: "Sweetie..."; "I wish you never joined!" -> the run up
// the stairs, the door SLAM; the silent living room: Dad slowly takes off his glasses; Mom: "Maybe we pushed too hard.";
// Granny knitting: "Go talk to him, dear. Not you. Him." (the needle points at Dad). The bedroom (dim blue, one warm lamp):
// the door opens, "Hey, champ.", Dad sits on the bed edge, the hero facing the wall; the sincere talk with slow, soft
// cameras (Dad's glasses in his hands, the hero's face on the pillow from the wall side, a year of polaroids, the "NOT NOW,
// DAD x200" pile -- a callback to FALLS 200); the hero turns around; the red flicker, the clock 10:59 -> 11:00, the PC
// flashes red, the SYSTEM warning (banner + red edges, the Block King's eyes on the monitor), "everything resets" (the
// family's records crushed to zero), the hero's face -> red flash into SC 09.
'use strict';

const K = require('./kit');
const G = require('./gameui');
const R = require('./respawn');
const GS = require('./sets_game');
const H = require('./sets_house');
const X = require('../rig/extras');
const AC = require('./acting');
const CAST = require('../rig/cast');
const E = require('./s07_env');
const S7 = require('./s07');
const { S, f, clamp, lerp, ease, seg, bump, hash, ol, ln, T, TF, camKeys, view, actor } = K;
const { L } = K.V;
const { tf, TS, pop, shakeAll, boing, whip, smash, zoomLines, panel, polaroid, glassesProp, letterbox } = E;
const camAt = GS.camAt;

const A = Array.from({ length: 14 }, (_, i) => L('08.' + i));
const T0 = K.V.scene('SC 08').start, END = K.V.scene('SC 09').start;    // == main.js RANGES for SC 08
const w = (i, word, n = 0) => A[i].word(word, n).t0;
const w1 = (i, word, n = 0) => A[i].word(word, n).t1;

// ---------------------------------------------------------------- the cut list (all from the voice)
const CUT = {};
CUT.mom = T0;
CUT.granny = w(0, 'Your', 1) - 0.12;
CUT.dad = w(0, 'Your', 2) - 0.12;
CUT.behind = A[1].a - 0.25;
CUT.board = w(1, 'were') - 0.12;
CUT.seethe = A[1].b + 0.2;
const tSlam = A[2].a - 0.18;
CUT.slam = tSlam - 0.24;
CUT.mygame = tSlam + 0.36;
CUT.friends = w(2, 'My', 1) - 0.12;
CUT.every = w(2, 'Youre') - 0.12;
CUT.sweetie = A[3].a - 0.15;
CUT.never = A[4].a - 0.06;
CUT.stairs = A[4].b + 0.08;
const tDoor = CUT.stairs + 0.64;
CUT.silent = tDoor + 0.3;
CUT.gtalk = A[6].a - 0.1;
CUT.notyou = w(6, 'Not') - 0.12;
CUT.him = w(6, 'Him') - 0.3;
CUT.door = A[6].b + 0.04;
CUT.walk = w(7, 'Can') - 0.15;
CUT.care = A[8].a - 0.15;
CUT.jump = w(8, 'I', 1) - 0.12;
CUT.noob = w(8, 'I', 2) - 0.12;
CUT.year = A[9].a - 0.1;
CUT.see = w(9, 'and') - 0.12;
CUT.asked = A[10].a - 0.45;
CUT.did = A[11].a - 0.12;
CUT.notnow = w(11, 'You') - 0.12;
CUT.turn = A[11].b + 0.15;
CUT.clock = w(12, 'eleven') - 0.2;
CUT.alarm = w(12, 'alarm') - 0.25;
CUT.warn = A[13].a - 0.1;
CUT.faces = w(13, 'If') - 0.12;
CUT.resets = w(13, 'everything') - 0.12;
CUT.final = A[13].b + 0.25;
{
  const ks = Object.keys(CUT);
  for (let i = 1; i < ks.length; i++) if (CUT[ks[i]] < CUT[ks[i - 1]] + 0.2) CUT[ks[i]] = CUT[ks[i - 1]] + 0.2;
}
// in-shot beats
const tBest = w(0, 'best'), tRich = w(0, 'richest'), tFav = w(0, 'everyones');
const tSon = w(1, 'son');
const tTurnFam = tSlam + 0.12;                         // everyone turns to the slam
const tFriends = w(2, 'friends'), tServer = w(2, 'server'), tEvery = w(2, 'EVERYTHING');
const tJoined = w(4, 'joined');
const tGlass0 = CUT.silent + 0.45, tGlassOff = tGlass0 + 0.75, tGlassDown = tGlassOff + 1.05;
const tHim = w(6, 'Him');
const tOpen = CUT.door + 0.12;
const tSit0 = CUT.walk + 1.45, tSit1 = tSit0 + 0.45;
const tNoob = w(8, 'noob');
const tWith = w(9, 'With');
const tHundred = w(11, 'hundred'), tTimes = w(11, 'times');
const tRoll = CUT.turn + 0.55;                         // the hero rolls over to face Dad
const tPM = w(12, 'pm');
const tAlarm = w(12, 'alarm');
const tSitUp = tAlarm + 0.12;
const tKing = w(13, 'King'), tAwake = w(13, 'awakened'), tResets = w(13, 'resets');

// ---------------------------------------------------------------- the living room
const LS = H.SPOTS.livingRoom.seats, LD = H.SPOTS.livingRoom.devices;
const MON = { cx: 598, cy: 378, w: 290, h: 168 }, DESK = { x0: 440, x1: 760, top: 632 };
const STAND = { x: 700, y: 1000 };                     // the hero standing in front of his desk
const LAUGH = { name: 'joy', mouth: 'bigGrin', eyes: { type: 'happy' } };
const lb = (ph, t, a = 1) => ({ bodyY: 7 * a * Math.abs(Math.sin(t * 10 + ph)), headRot: 5 * a * Math.sin(t * 10 + ph) });

// the hero's monitor (the set's own PC is switched off with pc: false so it can be slammed down like a laptop lid).
// fold 0..1 = tipped forward onto the desk; screen = fn(w, h) centred svg; world space k 1
function monitor(t, o = {}) {
  const fold = clamp(o.fold || 0, 0, 1);
  const x0 = MON.cx - MON.w / 2, y0 = MON.cy - MON.h / 2;
  let kb = S.path(`M528 ${DESK.top - 12} L668 ${DESK.top - 12} L676 ${DESK.top + 2} L520 ${DESK.top + 2} Z`, { fill: 'url(#hsRGB)', stroke: '#151515', 'stroke-width': 3.5, 'stroke-linejoin': 'round' }) + S.path(`M528 ${DESK.top - 6} H668`, ln(3, '#1E2029', 0.7));
  const mj = o.mouseJump || 0;
  kb += S.ellipse(704 + 10 * mj, DESK.top - 4 - 26 * mj, 12, 7, ol('#2A2D38', 3)) + S.ellipse(704 + 10 * mj, DESK.top - 7 - 26 * mj, 4, 2.5, { fill: '#33D6FF' });
  kb += S.g(S.path('M-24 0 L-24 -38 Q-24 -60 0 -60 Q24 -60 24 -38 L24 0', ln(9)) + S.path('M-24 0 L-24 -38 Q-24 -60 0 -60 Q24 -60 24 -38 L24 0', ln(5, '#E04848')) + S.rect(-32, -20, 16, 30, 6, ol('#2A2D38', 3)) + S.rect(16, -20, 16, 30, 6, ol('#2A2D38', 3)), `translate(486 ${DESK.top - 4})`);
  if (fold >= 1) {
    return S.rect(x0 - 16, DESK.top - 22, MON.w + 32, 22, 6, ol('#1E2029', 5)) + S.rect(x0 - 4, DESK.top - 15, MON.w + 8, 5, 2, { fill: 'url(#hsRGB)', opacity: 0.8 }) + kb;
  }
  let g = S.rect(x0 - 30, y0 - 26, MON.w + 60, MON.h + 56, 34, { fill: 'url(#hsRGB)', opacity: 0.3 * (1 - fold) });
  g += S.rect(MON.cx - 14, y0 + MON.h + 8, 28, DESK.top - y0 - MON.h - 8, 3, ol('#2A2D38', 3.5)) + S.ellipse(MON.cx, DESK.top - 1, 60, 7, ol('#2A2D38', 3.5));
  g += S.rect(x0 - 12, y0 - 12, MON.w + 24, MON.h + 30, 10, ol('#1E2029', 5)) + S.circle(x0 + MON.w - 6, y0 + MON.h + 9, 3, { fill: o.screen ? '#3DFF9A' : '#FF8A2A' });
  const scr = o.screen ? o.screen(MON.w, MON.h) : '';
  g += `<svg x="${f(x0)}" y="${f(y0)}" width="${MON.w}" height="${MON.h}" viewBox="${f(-MON.w / 2)} ${f(-MON.h / 2)} ${MON.w} ${MON.h}">${S.rect(-MON.w / 2, -MON.h / 2, MON.w, MON.h, 0, { fill: '#05060A' })}${scr}</svg>`;
  g += S.rect(x0, y0, MON.w, MON.h, 4, { fill: 'url(#hsShine)', opacity: 0.5 }) + S.rect(x0, y0, MON.w, MON.h, 4, ln(3, '#0A0B10'));
  g += S.g(S.rect(-20, -18, 40, 36, 2, ol('#FFE45C', 2.5)) + TF('LVL', 0, -2, 10, '#3A2A55') + TF('99', 0, 12, 12, '#E04848'), `translate(${x0 + 6} ${y0 - 4}) rotate(-8)`);
  if (fold > 0) {
    const piv = DESK.top - 2, sy = Math.max(0.05, Math.cos(fold * Math.PI / 2));
    g = S.g(g, `translate(0 ${f(piv)}) scale(1 ${f(sy)}) translate(0 ${f(-piv)})`);
  }
  return g + kb;
}
// the leaderboard on his screen (YOU slides from #2 to #47); roll 0..1, stamp 0..1
const BOARD_ROWS = [
  { rank: 1, from: 1, name: 'MOM_OFFICIAL', score: 9870 },
  { rank: 2, from: 3, name: 'GrannyGoodies', score: 8420 },
  { rank: 3, from: 60, name: 'DadBod1978', score: 7999, scoreFrom: 1 },
  { rank: 4, from: 4, name: 'xX_DarkBlade_Xx', score: 1530 },
  { rank: 5, from: 5, name: 'NoodleBoi', score: 1210 },
  { rank: 47, from: 2, name: 'YOU', score: 12, scoreFrom: 2001 },
];
function boardSvg(t, roll, stamp = 0, s = 1) {
  let o = G.leaderboard({ rows: BOARD_ROWS, nShow: 6, roll, t, highlight: 'YOU', title: 'TOP PLAYERS', unit: 'FANS', x: 0, y: 0, s: 1 });
  if (stamp > 0) o += G.stamp({ text: 'THE SON', k: stamp, x: 120, y: 340, s: 0.9, rot: -7, col: '#9AA3B8', size: 110 });
  return S.g(o, `scale(${f(s)})`);
}
const boardScreen = (t, roll, stamp) => (w_, h_) => boardSvg(t, roll, stamp, h_ / 900);
// the game picture on the monitor before the slam (the board at its end state)
const monScreen = (t) => boardScreen(t, 1, 1);

// the family on the couch + armchair. o.dad/o.mom/o.gran = pose extras, o.*Act = act
function family(t, o = {}) {
  let s = '';
  if (o.dad !== false) s += actor('dad', t, H.seatPose(LS.dad, 1.1, { t, ...(o.dad || {}) }), o.dadAct || { energy: 0 });
  if (o.mom !== false) s += actor('mom', t, H.seatPose(LS.mom, 1.04, { t, ...(o.mom || {}) }), o.momAct || { energy: 0 });
  if (o.gran !== false) s += actor('grandma', t, H.seatPose(LS.grandma, 0.9, { t, ...(o.gran || {}) }), o.granAct || { energy: 0 });
  return s;
}
function devices(o = {}) {
  return X.laptopOld({ ...LD.laptop, ...(o.lap || {}), face: 'lid' }) + X.tablet({ ...LD.tablet, ...(o.tab || {}), face: 'back', landscape: true });
}
// living-room frame: o = set options (+ glowK, chair), parts = { seated (after the monitor), standing, over, mon (monitor opts), devices }
function room(t, cam, o = {}, parts = {}) {
  const glow = o.glow ?? H.deviceGlows(['dad', 'mom', 'grandma'], o.glowK ?? 1);
  const mon = parts.mon === false ? '' : monitor(t, parts.mon || {});
  const monGlow = parts.mon && (parts.mon.fold || 0) >= 1 ? '' : H.glow(MON.cx, MON.cy, 240, 'hsGlowPurple', 0.5);
  return E.living(t, cam, { time: 'night', pc: false, chair: o.chair ?? 'back', glow, clock: '10:40', lamp: o.lamp ?? 0, ...(o.set || {}) },
    { seated: mon + (parts.seated || ''), devices: parts.devices ?? devices(parts.dev || {}), standing: parts.standing || '', over: (parts.mon === false ? '' : monGlow) + (parts.over || '') });
}
const heroSeat = (t, pose = {}, act) => actor('you', t, H.seatPose(LS.you, 1, { view: 'back', t, ...pose }), act || { arms: false, energy: 0 });

// the hero's R6 arm reaching in from off-frame (red jacket sleeve, white hand), screen space
function heroArm(x0, y0, x1, y1, wd = 150) {
  const a = Math.atan2(y1 - y0, x1 - x0) * 180 / Math.PI, len = Math.hypot(x1 - x0, y1 - y0);
  let o = S.rect(0, -wd / 2, len - wd * 0.9, wd, 20, ol('#E8433A', 8));
  o += S.path(`M${f(len * 0.4)} ${f(-wd / 2 + 16)} V${f(wd / 2 - 16)}`, ln(5, '#B92E28', 0.7));
  o += S.rect(len - wd * 1.05, -wd / 2 - 6, 54, wd + 12, 14, ol('#FFFFFF', 7));
  o += S.rect(len - wd * 0.95, -wd / 2 + 8, wd * 0.95, wd - 16, 28, ol('#FFFFFF', 8));
  return S.g(o, `translate(${f(x0)} ${f(y0)}) rotate(${f(a)})`);
}
// a knitting needle in a hand (body space): from (x, y) pointing at angle a (deg, 0 = screen-left), len
function needle(x, y, a = 0, len = 300) {
  const r = a * Math.PI / 180, dx = -Math.cos(r) * len, dy = -Math.sin(r) * len;
  return S.path(`M${f(x - dx * 0.15)} ${f(y - dy * 0.15)} L${f(x + dx)} ${f(y + dy)}`, ln(22, '#151515')) + S.path(`M${f(x - dx * 0.15)} ${f(y - dy * 0.15)} L${f(x + dx)} ${f(y + dy)}`, ln(12, '#F28AB8')) +
    S.circle(x - dx * 0.15, y - dy * 0.15, 20, ol('#FFD23F', 6)) + S.circle(x + dx, y + dy, 6, { fill: '#151515' });
}

// ---------------------------------------------------------------- game panels (full 1920x1080 frames, cropped by E.panel)
function momPanel(t) {
  const cam = camAt(960, 660, 1.3);
  const La = GS.arena.layers(t, cam, { time: 'day', cheer: 1, board: ['MOM_OFFICIAL', '#1'] });
  const sw = Math.sin(t * 5);
  let ch = actor('player', t, { i: 6, x: 1330, y: 905, s: 0.4, rot: -84, view: 'side', nametag: false, face: { name: 'dizzy' }, armL: 160, armR: 150, shadow: false });
  ch += actor('momAvatar', t, { x: 880, y: 905, s: 0.44, armor: 1, armR: 160 + 6 * sw, armL: 50, swordGlow: 1, face: { name: 'happy', eyes: { type: 'happy' } }, lift: 10 * Math.abs(sw), nametag: false }, { arms: false, energy: 0 });
  let over = G.koStars({ x: 1250, y: 820, t, s: 0.9, text: 'K.O.' });
  const oh = G.overHead(880, 905, 0.44, 'momAvatar');
  over += G.nametag({ x: 880, y: oh.tag, who: 'mom', level: 99, crown: true, t, s: 1.25 });
  return La.bg + La.mid + view(cam, ch + over) + La.front + La.fg + La.light;
}
function grannyPanel(t) {
  const cam = camAt(1520, 330, 0.62);
  const Lt = GS.tycoon.layers(t, cam, { time: 'day', granny: 4, billboard: 0, neon: 1 });
  const ch = actor('grandmaAvatar', t, { x: 1520, y: 930, s: 0.42, coins: 0.5 + 0.5 * Math.abs(Math.sin(t * 4)), armR: 120, face: { name: 'rich' }, nametag: false }, { arms: false, energy: 0 });
  let o = Lt.bg + Lt.mid + view(cam, ch) + Lt.front + Lt.light;
  o += G.coinCounter({ x: 960, y: 150, s: 2.1, value: 9999999, from: 9999000, roll: (t * 0.8) % 1, rocket: 1, t, anchor: 'center' });
  return o;
}
function dadPanel(t) {
  return S7.eveShot(t, camAt(2400, 790, 1.08));
}
// cheap mini-panels for "My friends! My server!"
function friendsPanel(t) {
  let o = S.rect(0, 0, 1920, 1080, 0, { fill: '#FFD9E8' }) + S.rect(0, 0, 1920, 330, 0, { fill: '#FFB3CF' });
  for (let i = 0; i < 6; i++) o += S.rect(80 + i * 320, 120, 220, 120, 16, ol('#FF8AB8', 6)) + TF('GG', 190 + i * 320, 200, 60, '#FFFFFF');
  o += S.rect(-20, 760, 1960, 120, 0, ol('#6A6F80', 8)) + S.path('M0 820 H1920', { stroke: '#4A4F60', 'stroke-width': 6, 'stroke-dasharray': '40 30', 'stroke-dashoffset': f(-t * 300) });
  for (let i = 0; i < 6; i++) { const x = ((i * 360 + t * 300) % 2200) - 140; o += X.cookie({ x, y: 742, s: 1.4 }); }
  o += actor('noodle', t, { x: 960, y: 1180, s: 0.95, apron: true, hairnet: true, armL: 40 + 10 * Math.sin(t * 9), armR: 50 + 10 * Math.sin(t * 9 + 1), face: { name: 'happy' }, nametag: false, volume: false }, { arms: false, energy: 0 });
  o += G.nametag({ x: 960, y: 140, name: 'NoodleBoi', col: '#17C3B2', level: 64, t, s: 1.8 });
  return o;
}
function serverPanel(t) {
  let o = S.rect(0, 0, 1920, 1080, 0, { fill: '#FFB08A' }) + S.rect(0, 0, 1920, 560, 0, { fill: '#C978C8', opacity: 0.55 }) + S.circle(1500, 600, 150, { fill: '#FFD06A' });
  o += S.rect(0, 860, 1920, 220, 0, { fill: '#E8B8D8' });
  const cr = [[300, 1020, 3], [520, 1060, 5], [1400, 1040, 9], [1620, 1070, 11], [1800, 1010, 2], [150, 1075, 7]];
  for (const [x, y, i] of cr) o += CAST.draw.noob(i, { x, y, s: 0.75, armL: 150 + 20 * Math.sin(t * 9 + i), armR: 150, lift: 20 * Math.abs(Math.sin(t * 9 + i)), face: 'joy', shadow: true, t });
  o += actor('dadAvatar', t, { x: 960, y: 1060, s: 0.8, armL: 120, armR: 120, face: { name: 'joy', mouth: 'bigGrin', eyes: { type: 'happy' } }, nametag: false, volume: false }, { arms: false, energy: 0 });
  o += G.nametag({ x: 960, y: 120, name: 'DAD', level: 99, col: '#FF5FA8', crown: true, t, s: 1.9 }) + G.emoteHearts({ x: 960, y: 200, age: (t * 0.9) % 1.6, n: 10, s: 1.6, seed: 3 });
  return o;
}

// ---------------------------------------------------------------- the bedroom
const SIT = SPB_SIT();
function SPB_SIT() { return H.SPOTS.bedroom.bed.sit; }
const LIE = H.SPOTS.bedroom.bed.lie;
const DOOR = H.SPOTS.bedroom.door;
const HSIT = { x: 600, hip: 726, s: 0.5, pose: { legL: 90, legR: 90, kneeL: 90, kneeR: 90 } };   // the hero sitting up on the bed edge
function bed(t, cam, o = {}, parts = {}) {
  return E.bedroom(t, cam, { clock: o.clock || '10:59', ...o }, parts);
}
// Dad on the bed edge, glasses off, holding them in his lap (body-space prop)
function dadBed(t, pose = {}, act = {}) {
  const p = { glasses: 'off', armL: 22, armR: 22, t, ...pose };
  const props = [...(p.props || [])];
  if (p.hold !== false) props.push({ svg: glassesProp(0, -350, 1.0, -6, 0.7), layer: 'front' });
  delete p.hold;
  return actor('dad', t, H.seatPose(SIT, 1.1, { ...p, props }), { energy: 0.5, arms: false, ...act });
}
const heroLie = (t, pose = {}, act = {}) => actor('you', t, { ...LIE, t, ...pose }, { energy: 0.3, arms: false, ...act });
// "wall side": the hero's face on the pillow, seen from the wall (tight; Dad an out-of-focus warm shape behind him)
function heroWall(t, o = {}) {
  const k = o.k ?? 0;                                     // slow push 0..1
  let out = S.rect(0, 0, 1920, 1080, 0, { fill: '#232A5C' });
  out += S.ellipse(1500, 300, 700, 520, { fill: '#3A3F78', opacity: 0.8 }) + S.ellipse(1560, 360, 360, 300, { fill: '#FFC872', opacity: 0.16 });
  // Dad, out of focus, sitting behind him (soft blob silhouette with a warm rim)
  const dx = 1470, dy = 760;
  out += S.g(S.rect(dx - 230, dy - 330, 460, 520, 120, { fill: '#5A4A6A' }) + S.rect(dx - 170, dy - 720, 340, 400, 110, { fill: '#6A5868' }) + S.rect(dx - 150, dy - 520, 300, 60, 30, { fill: '#4A3A3A' }), null, { opacity: 0.55 });
  out += S.rect(dx - 150, dy - 712, 300, 40, 20, { fill: '#FFC872', opacity: 0.25 });
  const s = lerp(1.55, 1.68, ease.inOut(k));
  const hx = 1980, hy = 690 + 10 * Math.sin(t * 1.3);
  // pillow
  out += S.rect(-80, hy - 40, 1100, 520, 120, { fill: '#E9ECF8', stroke: '#151515', 'stroke-width': 8 }) + S.path(`M40 ${hy + 60} Q400 ${hy + 20} 900 ${hy + 70}`, ln(6, '#C9CCE0'));
  out += actor('you', t, { x: hx, y: hy, s, rot: -90, view: 'front', volume: false, armL: 6, armR: 6, face: o.face || { name: 'sad', eyes: { look: [0, 0] } }, ...(o.pose || {}) }, o.act || { energy: 0.3, arms: false });
  // the duvet over his shoulder
  out += S.path(`M760 1090 Q820 ${hy + 160} 1150 ${hy + 120} Q1500 ${hy + 90} 1960 ${hy + 140} L1960 1090 Z`, { fill: '#2E8C8A', stroke: '#151515', 'stroke-width': 8 });
  out += S.path(`M900 ${hy + 250} l40 -30 l40 30 l-40 30 Z M1300 ${hy + 220} l40 -30 l40 30 l-40 30 Z M1700 ${hy + 260} l40 -30 l40 30 l-40 30 Z`, { fill: 'none', stroke: '#5FC4C0', 'stroke-width': 5 });
  // lamp warmth on his face side + night blue
  out += S.ellipse(560, 420, 620, 420, { fill: '#FFC872', opacity: 0.12 });
  out += S.rect(0, 0, 1920, 1080, 0, { fill: '#1A2050', opacity: 0.18 });
  return out + letterbox(1, 70);
}
// polaroid memory: the hero at his desk (back view) and Dad in the open door, one season. cheap-ish (bedroom set + 2 actors)
function memory(t, kind = 'day', dadPose = {}) {
  const cam = camAt(1560, 640, 1.55);
  const Lb = H.bedroom.layers(t, { time: kind === 'night' ? 'night' : kind === 'evening' ? 'evening' : 'day', door: 0.92, lamp: kind === 'night' ? 1 : 0, alarm: 0 });
  const hero = actor('you', 0, { x: 1420, y: 770 + 153, s: 0.5, view: 'back', headset: true, volume: false, armL: 30, armR: 30 }, { energy: 0 });
  const dd = actor('dad', 0, { x: DOOR.exit.x, y: DOOR.exit.y, s: 0.5, turn: -0.4, volume: false, glasses: 'up', armL: 10, armR: 120, face: { name: 'happy', mouth: 'smile' }, ...dadPose }, { energy: 0 });
  return view(cam, Lb.bg, 0.8) + view(cam, Lb.mid + hero + Lb.front + dd + Lb.light);
}
// a cheap snapshot for the "Not now, Dad" pile: Dad in a doorway asking (flat shapes), the caption under it
function snapDad(seed) {
  const bg = ['#F4E2C4', '#DCE6F2', '#F2D6D6', '#E2EED6', '#EDE0F4'][seed % 5];
  let o = S.rect(0, 0, 1920, 1080, 0, { fill: bg }) + S.rect(620, 120, 680, 980, 0, { fill: '#C9A57A', stroke: '#151515', 'stroke-width': 14 }) + S.rect(680, 170, 560, 930, 0, { fill: '#FFF1C8' });
  // Dad: head + moustache + vest (very flat)
  const hx = 960 + (hash(seed * 3.1) - 0.5) * 120;
  o += S.rect(hx - 210, 560, 420, 540, 60, { fill: '#E9B23C', stroke: '#151515', 'stroke-width': 12 }) + S.path(`M${hx - 150} 640 l75 75 l75 -75 l75 75 l75 -75`, ln(10, '#B5651D'));
  o += S.rect(hx - 160, 200, 320, 360, 40, { fill: '#F2C9A0', stroke: '#151515', 'stroke-width': 12 }) + S.rect(hx - 190, 190, 380, 90, 40, { fill: '#7A5A3A', stroke: '#151515', 'stroke-width': 12 });
  o += S.circle(hx - 60, 360, 16, { fill: '#151515' }) + S.circle(hx + 60, 360, 16, { fill: '#151515' }) + S.path(`M${hx - 110} 440 Q${hx} 400 ${hx + 110} 440 Q${hx} 470 ${hx - 110} 440 Z`, { fill: '#6A4A2A', stroke: '#151515', 'stroke-width': 8 });
  const prop = seed % 4;
  if (prop === 0) o += S.circle(hx + 330, 520, 80, ol('#FF8A2B', 12)) + S.path(`M${hx + 260} 500 Q${hx + 330} 470 ${hx + 400} 500`, ln(8, '#151515'));           // a ball
  else if (prop === 1) o += S.rect(hx + 230, 420, 220, 160, 12, ol('#3DB5FF', 12)) + TF('GAME', hx + 340, 520, 50, '#FFFFFF');                                         // a board game
  else if (prop === 2) o += S.path(`M${hx + 250} 760 L${hx + 420} 160`, ln(14, '#7A5A3A')) + S.path(`M${hx + 420} 160 Q${hx + 520} 400 ${hx + 470} 620`, ln(4, '#555555'));  // a fishing rod
  else o += S.rect(hx + 240, 440, 200, 140, 20, ol('#FFFFFF', 12)) + S.path(`M${hx + 270} 480 H${hx + 410} M${hx + 270} 520 H${hx + 380}`, ln(8, '#E04848'));          // a pizza box / note
  return o;
}

// ================================================================= shots
// 1. "Your mom was the best fighter." — Mom cracking up at her tablet; her game window pops out: BEST FIGHTER
function shMom(t) {
  const cam = camKeys(t, [[CUT.mom, camAt(1340, 560, 1.95, 560, 600)], [CUT.granny, camAt(1340, 555, 2.1, 560, 600)]], ease.inOut);
  const seated = family(t, { mom: { face: LAUGH, ...lb(1, t) }, dad: { face: LAUGH, ...lb(0, t) }, gran: { phone: 'arm', face: LAUGH, ...lb(2, t) } }) + heroSeat(t);
  let o = room(t, cam, {}, { seated, mon: { screen: monScreen(t) } });
  const k = seg(t, CUT.mom + 0.15, CUT.mom + 0.5);
  o += panel(1010, 120, 840, 472, momPanel(t), { k, rot: 3, label: 'BEST FIGHTER', labelCol: '#FF5FA8', ly: 600 });
  o += K.bang('#1', 1760, 150, pop(t, tBest, 0.25), 120, 12, '#FFD23F');
  o += E.TS('HA HA!', 300, 260 + 6 * Math.sin(t * 9), 64, '#FFD23F', { opacity: f(0.8 * seg(t, CUT.mom, CUT.mom + 0.3)), transform: 'rotate(-8 300 260)' });
  return o + (t < T0 + 0.12 ? E.smash(t, T0, 0.12, 0.6) : '');
}
// 2. "Your granny was the richest player." — whip right to Granny + her phone; RICHEST PLAYER (coins rocketing)
function shGranny(t) {
  const cam = camKeys(t, [[CUT.granny, camAt(1752, 590, 2.0, 1380, 600)], [CUT.dad, camAt(1752, 585, 2.12, 1380, 600)]], ease.inOut);
  const seated = family(t, { mom: { face: LAUGH, ...lb(1, t) }, dad: { face: LAUGH, ...lb(0, t) }, gran: { phone: 'arm', face: { name: 'joy', mouth: 'bigGrin', eyes: { type: 'robux' } }, ...lb(2, t) } });
  let o = room(t, cam, {}, { seated, mon: false });
  const k = seg(t, CUT.granny + 0.12, CUT.granny + 0.45);
  o += panel(70, 110, 840, 472, grannyPanel(t), { k, rot: -3, label: 'RICHEST PLAYER', labelCol: '#B57BFF', ly: 592 });
  o += K.bang('$$$', 1650, 200, pop(t, tRich, 0.25), 110, 10, '#7CFF8A');
  return o + whip(t, CUT.granny, 1, 0.1);
}
// 3. "Your dad was everyone's favorite." — whip left to Dad laughing at his laptop; EVERYONE'S FAVORITE (the DAD crowd)
function shDad(t) {
  const cam = camKeys(t, [[CUT.dad, camAt(1000, 560, 2.0, 560, 600)], [CUT.behind, camAt(1000, 556, 2.14, 560, 600)]], ease.inOut);
  const seated = family(t, { mom: { face: LAUGH, ...lb(1, t) }, dad: { face: { name: 'joy', mouth: 'bigGrin', eyes: { type: 'happy' }, fx: ['blush'] }, ...lb(0, t, 1.3) }, gran: { phone: 'arm', face: LAUGH } });
  let o = room(t, cam, {}, { seated, mon: { screen: monScreen(t) }, dev: { lap: { y: 846 } } });
  const k = seg(t, CUT.dad + 0.12, CUT.dad + 0.45);
  o += panel(1010, 110, 840, 472, dadPanel(t), { k, rot: 2, label: "EVERYONE'S FAVORITE", labelCol: '#FFD23F', ly: 592 });
  o += G.emoteHearts({ x: 560, y: 300, age: t - tFav, n: 10, s: 1.1, seed: 6 });
  return o + whip(t, CUT.dad, -1, 0.1);
}
// 4. "And you..." — from behind the hero at his PC: the family laughing in the screen glow; he sits alone in the dark
function shBehind(t) {
  const cam = camKeys(t, [[CUT.behind, { zoom: 1.0, x: 40, y: 20 }], [CUT.board, { zoom: 1.24, x: -170, y: 30 }]], ease.inOut);
  const seated = family(t, { mom: { face: LAUGH, ...lb(1, t) }, dad: { face: LAUGH, ...lb(0, t) }, gran: { phone: 'arm', face: LAUGH, ...lb(2, t) } }) + heroSeat(t, { headRot: -3 });
  let o = room(t, cam, { glowK: 1.2 }, { seated, mon: { screen: monScreen(t) } });
  o += S.rect(0, 0, 1920, 1080, 0, { fill: 'url(#s08Cold)' });
  const ha = (txt, x, y, ph) => TS(txt, x, y + 6 * Math.sin(t * 9 + ph), 56, '#FFD23F', { opacity: 0.8 });
  o += ha('HA HA', 1100, 230, 0) + ha('HO HO', 1520, 280, 2);
  return o;
}
// 5. "...were just 'the son.'" — his monitor fills the frame: the board rolls, YOU slides #2 -> #47; THE SON stamp
function shBoard(t) {
  const u = seg(t, CUT.board, CUT.seethe);
  const roll = seg(t, CUT.board + 0.15, tSon - 0.05);
  const st = seg(t, tSon, tSon + 0.3);
  let o = S.rect(0, 0, 1920, 1080, 0, { fill: '#0E1230' });
  o += G.deviceFrame({ type: 'pc', x: 960, y: 540, s: lerp(1.5, 1.62, ease.inOut(u)), t, glow: 0.6, screen: (w_, h_) => S.rect(0, 0, w_, h_, 0, { fill: '#0B1A3A' }) + S.g(boardSvg(t, roll, st, h_ / 920), `translate(${f(w_ / 2)} ${f(h_ / 2 + 8)})`) });
  o += S.rect(0, 0, 1920, 1080, 0, { fill: 'url(#s08Cold)' });
  return o;
}
// 6. (beat) the monitor POV: his face boils — trembling, the red rising, steam; the family laughs behind him
function shSeethe(t) {
  const u = seg(t, CUT.seethe, CUT.slam);
  const tr = 3 + 8 * u;
  const jit = Math.sin(t * 70) * tr;
  let o = E.heroPOV(t, { camP: camAt(1330, 560, 1.34), s: lerp(1.25, 1.42, ease.in(u)), x: 600 + jit, y: lerp(1360, 1420, u), red: u, face: { name: 'angry', mouth: 'teeth', eyes: { upper: 0.45, look: [0, 0] }, fx: u > 0.4 ? ['steam', 'anger'] : ['anger'] }, pose: { headRot: jit * 0.2, armL: 14, armR: 14 } });
  o += TS('HA HA HA!', 1400, 220 + 6 * Math.sin(t * 9), 60, '#FFD23F', { opacity: 0.85, transform: 'rotate(6 1400 220)' });
  return o + S.rect(0, 0, 1920, 1080, 0, { fill: '#FF2A2A', opacity: f(0.12 * u) });
}
// 7. SLAM — his hands grab the monitor and slam it face-down like a laptop lid; keys fly, the room goes dark
function shSlam(t) {
  const cam = shakeAll(camKeys(t, [[CUT.slam, camAt(598, 470, 2.55)], [tSlam, camAt(598, 500, 2.7)], [CUT.mygame, camAt(598, 520, 2.6)]], ease.out), t, [[tSlam, 0.4, 26]]);
  const fold = ease.in(seg(t, tSlam - 0.13, tSlam));
  const kd = seg(t, tSlam, tSlam + 0.4);
  let o = room(t, cam, { glowK: 1 }, { seated: '', mon: { fold, screen: monScreen(t), mouseJump: bump(t, tSlam, tSlam + 0.35) } });
  // keycaps flying out
  if (t > tSlam) {
    let kc = '';
    for (let i = 0; i < 7; i++) {
      const a = t - tSlam, vx = (hash(i * 3.3) - 0.5) * 260, vy = -220 - 160 * hash(i * 1.7);
      const x = 600 + (hash(i) - 0.5) * 130 + vx * a, y = DESK.top - 10 + vy * a + 0.5 * 1500 * a * a;
      if (y > 1300) continue;
      kc += S.g(S.rect(-12, -12, 24, 24, 4, ol(['#FF4FD8', '#33D6FF', '#FFE45C', '#3DFF9A'][i % 4], 3)) + TF('QWERTY'[i % 6], 0, 6, 14, '#151515'), `translate(${f(x)} ${f(y)}) rotate(${f(a * 900 * (hash(i * 5) - 0.5))})`);
    }
    o += view(cam, kc);
  }
  // the hands: reach in, grab the top corners, push down
  const top = MON.cy - MON.h / 2 - 12;
  const piv = DESK.top - 2, sy = Math.max(0.05, Math.cos(fold * Math.PI / 2));
  const ty = piv - (piv - top) * sy;
  const inK = ease.out(seg(t, CUT.slam, CUT.slam + 0.14));
  if (t < tSlam + 0.3) {
    const pL = GS.toScreen(cam, MON.cx - MON.w / 2 + 10, ty), pR = GS.toScreen(cam, MON.cx + MON.w / 2 - 10, ty);
    const lift = t > tSlam ? 120 * ease.out(seg(t, tSlam + 0.05, tSlam + 0.3)) : 0;
    o += heroArm(lerp(-200, 140, inK), 1250, lerp(-100, pL.x, inK), pL.y - 20 + lift, 170) + heroArm(lerp(2120, 1780, inK), 1250, lerp(2020, pR.x, inK), pR.y - 20 + lift, 170);
  }
  o += K.bang('SLAM!', 960, 330, pop(t, tSlam, 0.16), 200, -6, '#FF5A4A');
  o += smash(t, tSlam, 0.1, 0.8);
  return o + S.rect(0, 0, 1920, 1080, 0, { fill: '#000000', opacity: f(0.25 * kd) });
}
// 8. "This is MY game!" — the wide: everyone spins round; he's up, fists clenched, the monitor face-down behind him
function famTurned(t, t0, extra = {}) {
  const k = ease.out(seg(t, t0, t0 + 0.2));
  const jolt = boing(t, t0, 0.18);
  const shock = (look) => ({ name: 'shocked', eyes: { look }, fx: k > 0.5 ? ['exclaim'] : [] });
  return family(t, {
    dad: { face: k > 0.3 ? shock([-1, -0.1]) : LAUGH, turn: -0.35 * k, ...jolt, ...(extra.dad || {}) },
    mom: { face: k > 0.3 ? shock([-1, -0.1]) : LAUGH, turn: -0.45 * k, ...jolt, ...(extra.mom || {}) },
    gran: { phone: 'arm', face: k > 0.3 ? shock([-1, 0]) : LAUGH, turn: -0.25 - 0.35 * k, ...jolt, ...(extra.gran || {}) },
  });
}
function shMyGame(t) {
  const cam = shakeAll(camKeys(t, [[CUT.mygame, { zoom: 1.12, x: 60, y: 30 }], [CUT.friends, { zoom: 1.2, x: 20, y: 20 }]], ease.out), t, [[w(2, 'MY'), 0.3, 8]]);
  const up = ease.outBack(seg(t, CUT.mygame, CUT.mygame + 0.25));
  const seated = famTurned(t, tTurnFam);
  const hero = actor('you', t, { x: STAND.x, y: STAND.y, s: 0.5, turn: 0.55, lift: 40 * bump(t, CUT.mygame, CUT.mygame + 0.3), ...boing(t, CUT.mygame + 0.25, 0.25), face: { name: 'angry', fx: ['anger'] }, armL: 30 + 20 * up, armR: 30 + 20 * up }, { energy: 2 });
  let o = room(t, cam, { glowK: 0.9 }, { seated, standing: hero, mon: { fold: 1 } });
  return o + K.bang('MY GAME!', 980, 220, pop(t, w(2, 'MY'), 0.2) * (1 - seg(t, CUT.friends - 0.15, CUT.friends)), 110, -5, '#FF5A4A');
}
// 9. "My friends! My server!" — medium on him; on each word a panel of what he lost pops, stamped
function shFriends(t) {
  const cam = shakeAll(camKeys(t, [[CUT.friends, camAt(STAND.x + 40, 640, 2.05, 600, 560)], [tServer - 0.05, camAt(STAND.x + 40, 640, 2.12, 600, 560)], [tServer + 0.05, camAt(STAND.x + 40, 630, 2.3, 600, 560)], [CUT.every, camAt(STAND.x + 40, 628, 2.36, 600, 560)]], ease.out), t, [[tFriends, 0.25, 8], [tServer, 0.25, 10]]);
  const seated = famTurned(t, tTurnFam - 5);
  const hero = actor('you', t, { x: STAND.x, y: STAND.y, s: 0.5, turn: 0.5, face: { name: 'angry', fx: ['anger'] } }, { energy: 2 });
  let o = room(t, cam, { glowK: 0.9 }, { seated, standing: hero, mon: { fold: 1 } });
  o += S.rect(0, 0, 1920, 1080, 0, { fill: '#2A0A1A', opacity: 0.25 });
  const k1 = seg(t, tFriends - 0.15, tFriends + 0.15), k2 = seg(t, tServer - 0.15, tServer + 0.15);
  o += panel(1080, 70, 720, 405, friendsPanel(t), { k: k1, rot: -4 });
  o += G.stamp({ text: 'HIRED!', k: seg(t, tFriends + 0.25, tFriends + 0.6), x: 1450, y: 300, s: 0.8, rot: -10, col: '#FF3A4A', size: 120 });
  o += panel(1140, 520, 720, 405, serverPanel(t), { k: k2, rot: 3 });
  o += G.stamp({ text: 'TAKEN!', k: seg(t, tServer + 0.25, tServer + 0.6), x: 1500, y: 740, s: 0.8, rot: 8, col: '#FF3A4A', size: 120 });
  return o;
}
// 10. "You're taking EVERYTHING!" — smash zoom: the scream, red zoom lines, shake
function shEvery(t) {
  const cam = shakeAll(camKeys(t, [[CUT.every, camAt(STAND.x + 10, 560, 2.6)], [tEvery - 0.06, camAt(STAND.x + 10, 545, 2.75)], [tEvery + 0.06, camAt(STAND.x + 10, 520, 3.4)], [CUT.sweetie, camAt(STAND.x + 10, 515, 3.5)]], ease.out), t, [[tEvery, 0.6, 18]]);
  const seated = famTurned(t, tTurnFam - 5);
  const hero = actor('you', t, { x: STAND.x, y: STAND.y, s: 0.5, turn: 0.3, volume: false, face: t > tEvery - 0.1 ? { name: 'scream', fx: ['anger', 'steam'] } : { name: 'angry', fx: ['anger'] }, armL: 40 + 40 * bump(t, tEvery - 0.1, A[2].b), armR: 40 + 40 * bump(t, tEvery - 0.1, A[2].b) }, { energy: 2 });
  let o = room(t, cam, { glowK: 0.9 }, { seated, standing: hero, mon: { fold: 1 } });
  const zk = seg(t, tEvery - 0.06, tEvery + 0.1) * (1 - seg(t, A[2].b + 0.1, CUT.sweetie));
  o += zoomLines(960, 440, zk, t, '#FF3A3A', 26, 430) + S.rect(0, 0, 1920, 1080, 0, { fill: '#FF1E3C', opacity: f(0.18 * zk) });
  return o + smash(t, tEvery, 0.1, 0.5, '#FFD0D0');
}
// 11. MOM: "Sweetie..." — soft close on Mom, the tablet lowering, a hand reaching out
function shSweetie(t) {
  const cam = camKeys(t, [[CUT.sweetie, camAt(1340, 540, 2.35, 1100, 560)], [CUT.never, camAt(1340, 535, 2.5, 1100, 560)]], ease.inOut);
  const seated = family(t, { mom: { face: { name: 'sad', eyes: { look: [-1, -0.1] } }, turn: -0.45, armL: 40 + 20 * seg(t, CUT.sweetie, A[3].b) }, momAct: { energy: 0.5, arms: false }, dad: { face: { name: 'sad', eyes: { look: [-1, 0] } }, turn: -0.35 }, gran: { phone: 'arm', face: { name: 'sad', eyes: { look: [-1, 0] } }, turn: -0.6 } });
  return room(t, cam, { glowK: 0.7 }, { seated, mon: { fold: 1 }, dev: { tab: { y: 760, rot: -8 } } });
}
// 12. "I wish you never joined!" — close on him: the tears, the scream; he spins and bolts
function shNever(t) {
  const tGo = A[4].b - 0.08;
  const cam = shakeAll(camKeys(t, [[CUT.never, camAt(STAND.x, 545, 2.7)], [tJoined, camAt(STAND.x, 540, 2.9)], [CUT.stairs, camAt(STAND.x + 60, 540, 3.0)]], ease.out), t, [[tJoined, 0.4, 12]]);
  const go = seg(t, tGo, CUT.stairs);
  const seated = famTurned(t, tTurnFam - 5);
  const face = { name: 'angry', mouth: t > w(4, 'never') ? 'scream' : 'teeth', fx: ['tears', 'anger'] };
  const hero = go <= 0 ? actor('you', t, { x: STAND.x, y: STAND.y, s: 0.5, turn: 0.25, volume: false, face, headRot: 2 * Math.sin(t * 40) }, { energy: 1.8 })
    : actor('you', t, { x: STAND.x + 900 * ease.in(go), y: STAND.y, s: 0.5, view: 'side', flip: true, volume: false, ...AC.run(t * 22), lean: 14, face: { name: 'crying' } }, { arms: false });
  let o = room(t, cam, { glowK: 0.8 }, { seated, standing: hero, mon: { fold: 1 } });
  if (go > 0) o += K.C.speedLines ? '' : '';
  // tears flying off as he turns
  if (go > 0) { let d = ''; for (let i = 0; i < 6; i++) { const a = go + i * 0.05; d += `M${f(700 - 600 * a + i * 30)} ${f(330 + i * 18 + 200 * a * a)} m-12 0 a12 16 0 1 0 24 0 a12 16 0 1 0 -24 0`; } o += S.path(d, { fill: '#9FE3FF', stroke: '#151515', 'stroke-width': 4 }); }
  return o + whip(t, CUT.stairs, 1, 0.1);
}
// 13. the run up the stairs (a blur) and the door SLAM
function stairsY(x) { return x >= 1380 ? 420 : x <= 420 ? 940 : Math.min(940, 460 + (1340 - x) * 0.5); }
function shStairs(t) {
  const cam = shakeAll({ zoom: 0.98, x: 10, y: -30 }, t, [[tDoor, 0.45, 20]]);
  const u = seg(t, CUT.stairs, tDoor - 0.1);
  const doorK = t < tDoor - 0.04 ? 1 : 1 - ease.in(seg(t, tDoor - 0.04, tDoor));
  const Ls = H.stairs.layers(t, { time: 'night', heroDoor: doorK, heroLight: 'warm', tvGlow: 1 });
  let ch = '';
  if (u < 1) {
    const hx = lerp(240, 1640, ease.inOut(u)), hy = stairsY(hx);
    for (let g = 3; g >= 0; g--) {
      const ug = Math.max(0, u - g * 0.05), gx = lerp(240, 1640, ease.inOut(ug));
      const s = actor('you', t, { x: gx, y: stairsY(gx), s: 0.32, view: 'side', flip: true, ...AC.run(t * 30), lean: 14, face: { name: 'crying' } }, { arms: false });
      ch += g ? S.g(s, null, { opacity: f(0.18 * (4 - g)) }) : s;
    }
    if (hx > 1600) ch = '';
  }
  let o = view(cam, (Ls.bg || '') , 0.8) + view(cam, Ls.mid + ch + Ls.front + Ls.light);
  if (u > 0 && u < 1) o += E.vStreaks ? '' : '';
  const q = H.toScreen ? null : null;
  o += K.bang('SLAM!!', 1560, 170, pop(t, tDoor, 0.16), 140, 8, '#FFFFFF');
  return o + smash(t, tDoor, 0.08, 0.5) + whip(t, CUT.stairs, 1, 0.1);
}
// 14. the silent living room: everyone frozen; the slow push to the couch; Dad slowly takes off his glasses;
//     Mom: "Maybe we pushed too hard."
function dadGlassesPose(t, base = {}) {
  const up = ease.inOut(seg(t, tGlass0, tGlassOff));
  const down = ease.inOut(seg(t, tGlassOff + 0.15, tGlassDown));
  const armR = lerp(lerp(24, 168, up), 30, down);
  const off = t >= tGlassOff;
  const p = { ...base, glasses: off ? 'off' : 'up', armR, armL: 22, face: { name: 'sad', eyes: { look: off ? [0.2, 0.7] : [0.6, -0.1] } }, headY: 10 * down, headRot: -3 * down };
  if (off) {
    const h = CAST.handAt(CAST.D.dad, { armR }, 1);
    const sl = ease.out(seg(t, tGlassOff, tGlassOff + 0.25));
    const gx = lerp(0, h[0] - 30, sl), gy = lerp(-905, h[1] - 50, sl);
    p.props = [{ svg: glassesProp(gx, gy, 0.95, -8 + 14 * down, 0.4 * down), layer: 'front' }];
  }
  return p;
}
function shSilent(t) {
  const cam = camKeys(t, [[CUT.silent, { zoom: 1.04, x: 100, y: 20 }], [CUT.silent + 0.5, { zoom: 1.06, x: 110, y: 18 }], [CUT.gtalk, { zoom: 1.72, x: 215, y: -40 }]], ease.inOut);
  const seated = family(t, {
    dad: dadGlassesPose(t, { turn: -0.15 }), dadAct: { energy: 0, arms: false },
    mom: { face: { name: 'sad', eyes: { look: t > A[5].a - 0.3 ? [-0.9, 0.1] : [1, -0.1] } }, turn: t > A[5].a - 0.3 ? -0.35 : 0.2 }, momAct: { energy: 0.4, arms: false },
    gran: { knitting: true, face: { name: 'sad', eyes: { look: [1, 0.1] } }, turn: 0.1 },
  });
  let o = room(t, cam, { glowK: 0.6, set: { clock: '10:41' } }, { seated, mon: { fold: 1 } });
  return o + letterbox(seg(t, CUT.silent, CUT.silent + 0.6), 60);
}
// 15. GRANNY: "Go talk to him, dear." — close on Granny knitting, calm, not looking up
function granKnit(t, extra = {}) {
  const ph = Math.sin(t * 7);
  return { knitting: true, armL: 24 + 6 * ph, armR: 24 - 6 * ph, face: { name: 'neutral', eyes: { look: [0, 0.7], upper: 0.3 } }, ...extra };
}
function shGTalk(t) {
  const cam = camKeys(t, [[CUT.gtalk, camAt(1745, 600, 2.4, 1250, 560)], [CUT.notyou, camAt(1745, 596, 2.55, 1250, 560)]], ease.inOut);
  const seated = family(t, { dad: dadGlassesPose(t, { turn: -0.1 }), mom: { face: { name: 'sad', eyes: { look: [1, 0] } }, turn: 0.3 }, gran: granKnit(t), granAct: { energy: 0.5, arms: false } });
  return room(t, cam, { glowK: 0.6, set: { lamp: 0.4 } }, { seated, mon: { fold: 1 } }) + letterbox(1, 60);
}
// 16. "Not you." — Mom half-way up, Granny's needle stops her; Mom sits back down
function shNotYou(t) {
  const cam = camKeys(t, [[CUT.notyou, camAt(1550, 600, 1.75)], [CUT.him, camAt(1560, 596, 1.82)]], ease.inOut);
  const rise = ease.out(seg(t, CUT.notyou - 0.05, CUT.notyou + 0.25)) * (1 - ease.inOut(seg(t, w(6, 'you', 1) + 0.25, CUT.him)));
  const nk = ease.outBack(seg(t, w(6, 'Not') - 0.05, w(6, 'Not') + 0.2));
  const ga = lerp(24, 120, nk);
  const gp = { knitting: false, armL: ga, armR: 24, face: { name: 'deadpan', eyes: { look: [-1, -0.2] } } };
  const h = CAST.handAt(CAST.D.grandma, { armL: ga, turn: -0.25 }, -1);
  gp.props = [{ svg: needle(h[0], h[1], -55 * nk + 0, 300) + X.knittingYarn({ x: 90, y: -300, s: 0.7, ball: [180, 200], needles: false }), layer: 'front' }];
  const seated = family(t, {
    dad: dadGlassesPose(t, { turn: 0.25, face: { name: 'sad', eyes: { look: [1, 0] } } }),
    mom: { y: H.seatPose(LS.mom, 1.04).y - 90 * rise, lean: 14 * rise, face: { name: rise > 0.5 && t > w(6, 'you', 1) ? 'nervous' : 'sad', eyes: { look: [1, 0] } }, turn: 0.3, armL: 20 + 30 * rise, armR: 20 + 30 * rise },
    gran: gp, granAct: { energy: 0.5, arms: false },
  });
  return room(t, cam, { glowK: 0.6, set: { lamp: 0.4 } }, { seated, mon: { fold: 1 } }) + letterbox(1, 60);
}
// 17. "Him." — the needle swings to Dad; snap-zoom onto Dad (holding his glasses): gulp
function shHim(t) {
  const cam = camKeys(t, [[CUT.him, camAt(1380, 590, 1.45)], [tHim - 0.04, camAt(1360, 590, 1.48)], [tHim + 0.1, camAt(1000, 560, 2.3)], [CUT.door, camAt(1000, 556, 2.38)]], ease.inOut);
  const sw = ease.inOut(seg(t, CUT.him + 0.05, tHim));
  const ga = lerp(120, 96, sw);
  const gp = { knitting: false, armL: ga, armR: 24, turn: -0.5, face: { name: 'smug', eyes: { look: [-1, 0] } } };
  const h = CAST.handAt(CAST.D.grandma, { armL: ga, turn: -0.5 }, -1);
  gp.props = [{ svg: needle(h[0], h[1], lerp(-55, -4, sw), 320) + X.knittingYarn({ x: 90, y: -300, s: 0.7, ball: [180, 200], needles: false }), layer: 'front' }];
  const hit = t >= tHim;
  const seated = family(t, {
    dad: dadGlassesPose(t, { turn: hit ? 0.3 : 0.2, face: hit ? { name: 'shocked', eyes: { look: [1, 0] }, fx: ['sweat'] } : { name: 'sad', eyes: { look: [1, 0] } }, ...boing(t, tHim, 0.15) }),
    mom: { face: { name: 'happy', eyes: { look: [-1, 0] } }, turn: -0.3 },
    gran: gp, granAct: { energy: 0.5, arms: false },
  });
  let o = room(t, cam, { glowK: 0.6, set: { lamp: 0.4 } }, { seated, mon: { fold: 1 } });
  o += K.bang('!', 760, 210, pop(t, tHim + 0.05, 0.2), 150, 8, '#FFFFFF');
  return o + letterbox(1, 60) + smash(t, tHim, 0.08, 0.35);
}

// ---------------------------------------------------------------- the bedroom (slow, soft cameras)
// 18. the door opens: the hall light falls in; Dad in the doorway: "Hey, champ." The hero faces the wall.
function shDoor(t) {
  const cam = camKeys(t, [[CUT.door, { zoom: 1.12, x: 200, y: 40 }], [CUT.walk, { zoom: 1.22, x: 260, y: 30 }]], ease.inOut);
  const door = ease.inOut(seg(t, tOpen, tOpen + 0.9)) * 0.9;
  const tuck = ease.inOut(seg(t, A[7].a + 0.2, A[7].a + 1.2));
  const dd = door > 0.35 ? actor('dad', t, { x: DOOR.exit.x, y: DOOR.exit.y, s: 0.5, turn: -0.5, glasses: 'off', t, armL: 14, armR: 30, face: { name: 'sad', mouth: 'smallSmile', eyes: { look: [-1, 0.2] } }, props: [{ svg: glassesProp(230, -330, 0.9, 10, 0.7), layer: 'front' }] }, { energy: 0.5, arms: false }) : '';
  return bed(t, cam, { door, tuck: 0.4 + 0.5 * tuck }, { behind: heroLie(t, { view: 'back' }), front: dd }) + letterbox(1, 60) + E.fadeIn(t, CUT.door, 0.35);
}
// 19. "Can I tell you something?" — he crosses the room and sits on the bed edge
function shWalk(t) {
  const cam = camKeys(t, [[CUT.walk, { zoom: 1.25, x: 200, y: 30 }], [tSit1, { zoom: 1.42, x: -180, y: 32 }], [CUT.care, { zoom: 1.45, x: -200, y: 30 }]], ease.inOut);
  const u = seg(t, CUT.walk, tSit0);
  let dd;
  if (t < tSit0) {
    const x = lerp(DOOR.exit.x - 40, SIT.x + 70, ease.inOut(u)), y = lerp(DOOR.exit.y, 990, ease.inOut(u));
    dd = actor('dad', t, { x, y, s: 0.5, view: 'side', glasses: 'off', t, ...AC.walk(t * 7), face: { name: 'sad', mouth: 'smallSmile' } }, { energy: 0.5, arms: false });
  } else {
    const k = ease.inOut(seg(t, tSit0, tSit1));
    const sp = H.seatPose(SIT, 1.1);
    dd = dadBed(t, { x: lerp(SIT.x + 70, sp.x, k), y: lerp(990, sp.y, k), legL: 90 * k, legR: 90 * k, kneeL: 90 * k, kneeR: 90 * k, turn: lerp(-0.2, -0.4, k), face: { name: 'sad', mouth: 'smallSmile', eyes: { look: [-0.9, 0.2] } }, hold: k > 0.6 });
    dd = actor('dad', t, H.seatPose(SIT, 1.1, { x: lerp(SIT.x + 70, sp.x, k), y: lerp(990, sp.y, k), legL: 90 * k, legR: 90 * k, kneeL: 90 * k, kneeR: 90 * k, turn: lerp(-0.2, -0.4, k), glasses: 'off', t, armL: 22, armR: 22, face: { name: 'sad', mouth: 'smallSmile', eyes: { look: [-0.9, 0.2] } }, ...boing(t, tSit1, 0.12), props: [{ svg: glassesProp(0, -350, 1.0, -6, 0.7), layer: 'front' }] }), { energy: 0.5, arms: false });
  }
  return bed(t, cam, { door: 0.9, tuck: 0.9 }, { behind: heroLie(t, { view: 'back' }), front: dd }) + letterbox(1, 60);
}
// 20. "I don't care about the game." — Dad's close-up, looking down at his glasses
function shCare(t) {
  const cam = camKeys(t, [[CUT.care, camAt(870, 540, 2.45)], [CUT.jump, camAt(865, 530, 2.62)]], ease.inOut);
  const lookUp = seg(t, w(8, 'game') - 0.2, w(8, 'game') + 0.2);
  const dd = dadBed(t, { face: { name: 'sad', mouth: 'smallSmile', eyes: { look: lookUp > 0.5 ? [-0.8, 0] : [0, 0.7] } } });
  let o = bed(t, cam, { door: 0.9, tuck: 0.9 }, { behind: heroLie(t, { view: 'back' }), front: dd });
  o += S.ellipse(300, 400, 520, 420, { fill: '#FFC872', opacity: 0.08 });
  return o + letterbox(1, 60);
}
// 21. "I don't know how to jump." — the wall side: the hero's face on the pillow, eyes open, listening
function shJump(t) {
  const k = seg(t, CUT.jump, CUT.noob);
  const smirk = bump(t, w(8, 'jump'), w(8, 'jump') + 0.9);
  return heroWall(t, { k, face: { name: 'sad', mouth: smirk > 0.4 ? 'smallSmile' : 'line', eyes: { look: [0.1, 0], upper: 0.25 } } });
}
// 22. "I don't even know what a 'noob' is." — the two-shot; a little "noob?" thought pops over Dad
function shNoob(t) {
  const cam = camKeys(t, [[CUT.noob, { zoom: 1.42, x: -200, y: 32 }], [CUT.year, { zoom: 1.52, x: -230, y: 30 }]], ease.inOut);
  const shrug = bump(t, w(8, 'even') - 0.1, w(8, 'is') + 0.3);
  const dd = dadBed(t, { face: { name: 'sad', mouth: 'smallSmile', eyes: { look: [-0.9, -0.1] } }, bodyY: -8 * shrug, armL: 22 + 18 * shrug, armR: 22 + 18 * shrug, headRot: 6 * shrug });
  let o = bed(t, cam, { door: 0.9, tuck: 0.9 }, { behind: heroLie(t, { view: 'back' }), front: dd });
  const nk = seg(t, tNoob - 0.1, tNoob + 0.2) * (1 - seg(t, CUT.year - 0.3, CUT.year));
  if (nk > 0) {
    const q = GS.toScreen(cam, SIT.x + 150, SIT.hip - 520);
    let th = S.circle(-120, 170, 14, ol('#FFFFFF', 5)) + S.circle(-80, 120, 22, ol('#FFFFFF', 5)) + S.ellipse(0, 0, 150, 120, ol('#FFFFFF', 7));
    th += CAST.draw.noob(3, { x: -20, y: 80, s: 0.2, face: 'confused', shadow: false }) + TS('?', 80, 30, 90, '#FFD23F');
    o += S.g(th, tf(q.x + 60, q.y - 40, ease.outBack(nk)));
  }
  return o + letterbox(1, 60);
}
// 23. "You've been in that world for a whole year..." — a year of polaroids: always at the desk, Dad always at the door
function shYear(t) {
  const cam = { zoom: 1.5, x: -210, y: 30 };
  let o = bed(t, cam, { door: 0.9, tuck: 0.9 }, { behind: heroLie(t, { view: 'back' }), front: dadBed(t, { face: { name: 'sad', mouth: 'smallSmile', eyes: { look: [-0.9, 0] } } }, { energy: 0 }) });
  o += S.rect(0, 0, 1920, 1080, 0, { fill: '#0E1230', opacity: 0.62 });
  const P = [[w(9, 'been') - 0.1, 470, 470, -7, 'day', 'SPRING'], [w(9, 'world') - 0.05, 960, 430, 4, 'evening', 'SUMMER'], [w(9, 'whole') - 0.1, 1450, 480, -3, 'night', 'WINTER']];
  const out = seg(t, CUT.see - 0.35, CUT.see);
  P.forEach(([t0, x, y, r, kind, cap], j) => {
    const k = seg(t, t0, t0 + 0.45);
    if (k <= 0) return;
    o += polaroid(x, y - 40 * out, 440, memory(t, kind, { armR: [120, 150, 100][j] }), { k: k * (1 - out), rot: r, caption: cap, tape: true });
  });
  const ck = seg(t, w(9, 'year') - 0.1, w(9, 'year') + 0.3) * (1 - out);
  if (ck > 0) o += S.g(S.rect(-200, -48, 400, 96, 48, ol('#FFE45C', 7)) + TS('365 DAYS', 0, 20, 58, '#FFFFFF'), tf(960, 850, ease.outBack(ck)));
  return o + letterbox(1, 60);
}
// 24. "and I just wanted to see it. With you." — the soft two-shot; the lamp warms on "With you."
function shSee(t) {
  const cam = camKeys(t, [[CUT.see, { zoom: 1.45, x: -210, y: 30 }], [CUT.asked, { zoom: 1.68, x: -265, y: 40 }]], ease.inOut);
  const warm = seg(t, tWith - 0.3, tWith + 0.6);
  const reach = ease.inOut(seg(t, tWith - 0.5, tWith + 0.2));
  const dd = dadBed(t, { face: { name: 'sad', mouth: 'smallSmile', eyes: { look: [-0.9, 0] } }, armL: lerp(22, 52, reach), turn: -0.45 });
  let o = bed(t, cam, { door: 0.9, tuck: 0.9 }, { behind: heroLie(t, { view: 'back' }), front: dd });
  const q = GS.toScreen(cam, 420, 560);
  o += S.ellipse(q.x + 200, q.y + 60, 700, 520, { fill: '#FFC872', opacity: f(0.04 + 0.1 * warm) });
  if (warm > 0 && warm < 1) o += K.sparkles([[q.x + 80, q.y - 120, 24 * Math.sin(Math.PI * warm)], [q.x + 420, q.y - 40, 18 * Math.sin(Math.PI * warm)]], t);
  return o + letterbox(1, 60);
}
// 25. "...You could've just asked." — the wall side again: tears, a small voice
function shAsked(t) {
  const k = seg(t, CUT.asked, CUT.did);
  return heroWall(t, { k: 0.3 + 0.7 * k, face: { name: 'sad', eyes: { look: [0, 0.1], upper: 0.3 }, fx: t > A[10].a - 0.2 ? ['tears'] : [] }, act: { energy: 0.4, arms: false } });
}
// 26. "I did." — Dad close, a small laugh
function shDid(t) {
  const cam = camKeys(t, [[CUT.did, camAt(870, 530, 2.6)], [CUT.notnow, camAt(866, 528, 2.72)]], ease.inOut);
  const chuck = Math.abs(Math.sin(t * 14)) * bump(t, A[11].a, w1(11, 'did') + 0.2);
  const dd = dadBed(t, { face: { name: 'happy', mouth: 'smallSmile', eyes: { look: [-0.8, 0], type: chuck > 0.3 ? 'happy' : undefined } }, bodyY: 5 * chuck });
  return bed(t, cam, { door: 0.9, tuck: 0.9 }, { behind: heroLie(t, { view: 'back' }), front: dd }) + letterbox(1, 60);
}
// 27. "You said, 'Not now, Dad.' About two hundred times." — the pile of snapshots: NOT NOW, DAD x200
const NN = { t0: () => w(11, 'Not') - 0.05, t1: () => tHundred + 0.05 };
function nnCount(t) {
  const a = NN.t0(), b = NN.t1();
  if (t < a) return 0;
  if (t < w1(11, 'Dad')) return 1;
  return Math.min(200, Math.round(1 + 199 * Math.pow(seg(t, w1(11, 'Dad'), b), 2.2)));
}
function shNotNow(t) {
  const cam = { zoom: 1.5, x: -210, y: 30 };
  let o = bed(t, cam, { door: 0.9, tuck: 0.9 }, { behind: heroLie(t, { view: 'back' }), front: dadBed(t, { face: { name: 'happy', mouth: 'smallSmile', eyes: { look: [-0.8, 0] } } }, { energy: 0 }) });
  o += S.rect(0, 0, 1920, 1080, 0, { fill: '#0E1230', opacity: 0.66 });
  const n = nnCount(t);
  // the first one: a real memory (Dad at the door with a smile, the hero's back at the desk)
  const k0 = seg(t, CUT.notnow + 0.05, CUT.notnow + 0.5);
  const first = polaroid(700, 470, 520, memory(t, 'evening', { armR: 140 }), { k: k0, rot: -5, caption: '"NOT NOW, DAD."', tape: true });
  // the pile: the last 6 snapshots (cheap), dealt faster and faster
  let pile = '';
  const nShow = Math.max(0, n - 1);
  for (let i = Math.max(1, nShow - 5); i <= nShow; i++) {
    const age = i === nShow ? seg(t, NN.t0() + 0.2, NN.t0() + 0.2) : 1;
    const x = 760 + (hash(i * 1.7) - 0.5) * 900, y = 470 + (hash(i * 2.9) - 0.5) * 300, r = (hash(i * 4.1) - 0.5) * 30;
    pile += polaroid(x, y, 330, snapDad(i), { k: i === nShow ? Math.min(1, 0.5 + age) : 1, rot: r, caption: 'NOT NOW, DAD.' });
  }
  o += first + pile;
  const big = seg(t, tHundred, tHundred + 0.45);
  o += G.statPill({ x: 960, y: 900, s: 1.25 + 0.35 * big, k: seg(t, NN.t0() - 0.1, NN.t0() + 0.2), t, anchor: 'center', label: 'NOT NOW, DAD', value: '×' + n, rim: '#FF8A2B', bump: big });
  return o + letterbox(1, 60);
}
// 28. (beat) the hero slowly rolls over and looks at his Dad
function shTurn(t) {
  const cam = camKeys(t, [[CUT.turn, { zoom: 1.5, x: -230, y: 30 }], [CUT.clock, { zoom: 1.64, x: -280, y: 36 }]], ease.inOut);
  const rolled = t >= tRoll;
  const hero = heroLie(t, rolled ? { view: 'front', face: { name: 'sad', mouth: 'smallSmile', eyes: { look: [0.8, -0.4] }, fx: ['tears'] }, ...boing(t, tRoll, 0.15) } : { view: 'back', ...boing(t, tRoll - 0.25, 0.1) });
  const dd = dadBed(t, { face: { name: rolled ? 'happy' : 'sad', mouth: 'smallSmile', eyes: { look: [-0.9, 0] } }, turn: -0.45 });
  let o = bed(t, cam, { door: 0.9, tuck: 0.9 }, { behind: hero, front: dd });
  // the first red flicker from the monitor (screen-right)
  const fl = bump(t, CUT.clock - 0.5, CUT.clock - 0.3) + bump(t, CUT.clock - 0.2, CUT.clock - 0.05);
  o += S.rect(1500, 0, 420, 1080, 0, { fill: '#FF2440', opacity: f(0.18 * fl) });
  return o + letterbox(1, 60);
}
// 29. "at eleven p.m...." — the bedside clock: 10:59 -> 11:00
function shClock(t) {
  const flip = t >= tPM;
  const cam = shakeAll(camKeys(t, [[CUT.clock, camAt(132, 560, 4.2)], [CUT.alarm, camAt(132, 565, 4.6)]], ease.inOut), t, [[tPM, 0.25, 6]]);
  let o = bed(t, cam, { door: 0.9, tuck: 0.9, clock: flip ? '11:00' : '10:59', alarm: 0.15 * bump(t, tPM, tPM + 0.4) });
  o += S.rect(0, 0, 1920, 1080, 0, { fill: '#FF2440', opacity: f(0.12 * bump(t, tPM, tPM + 0.5)) });
  return o + letterbox(1, 60) + smash(t, tPM, 0.08, 0.3, '#FFD0D8');
}
// 30. "the alarm went off." — the PC flashes red; the push from the bed to the monitor; both turn, the hero sits up
function heroSitUp(t, extra = {}) {
  return actor('you', t, H.seatPose(HSIT, 1, { t, turn: 0.45, face: { name: 'shocked', eyes: { look: [1, -0.1] } }, ...boing(t, tSitUp, 0.2), ...extra }), { energy: 0.6, arms: false });
}
function shAlarm(t) {
  const a = seg(t, tAlarm - 0.05, tAlarm + 0.15);
  const cam = camKeys(t, [[CUT.alarm, { zoom: 1.45, x: -150, y: 30 }], [tAlarm + 0.1, { zoom: 1.5, x: -100, y: 24 }], [CUT.warn, { zoom: 2.3, x: 380, y: -50 }]], ease.inOut);
  const up = t >= tSitUp;
  const hero = up ? heroSitUp(t) : heroLie(t, { view: 'front', face: { name: 'sad', eyes: { look: [0.8, -0.4] } } });
  const dd = dadBed(t, { face: up ? { name: 'shocked', eyes: { look: [1, -0.1] }, fx: ['sweat'] } : { name: 'happy', mouth: 'smallSmile', eyes: { look: [-0.9, 0] } }, turn: up ? 0.35 : -0.45, ...boing(t, tSitUp, 0.12) });
  let o = bed(t, cam, { door: 0.9, tuck: up ? 0.2 : 0.9, alarm: a, clock: '11:00' }, { behind: up ? '' : hero, front: (up ? hero : '') + dd });
  return o + letterbox(1, 60) + smash(t, tAlarm, 0.1, 0.5, '#FF8090');
}
// the Block King on the hero's monitor (screen fn, centred): dark red, his eyes igniting on "awakened"
const kingScreen = (t) => (w_, h_) => {
  const eye = seg(t, tAwake - 0.1, tAwake + 0.15);
  let o = S.rect(-w_ / 2, -h_ / 2, w_, h_, 0, { fill: '#2A0610' });
  o += actor('boss', t, { x: 0, y: h_ * 1.55, s: h_ / 560, t, pose: 'rise', rise: 1, glow: 0.3 + 1.1 * eye, idle: true }, { energy: 0 });
  o += S.rect(-w_ / 2, -h_ / 2, w_, h_, 0, { fill: '#FF1E3C', opacity: f(0.18 + 0.1 * Math.sin(t * 9)) });
  return o;
};
// 31. SYSTEM: "Warning! The Block King has awakened!" — the monitor: WARNING -> the Block King's eyes; the banner + red edges
function banner(t) {
  const k = seg(t, CUT.warn - 0.1, CUT.warn + 0.5), out = seg(t, END - 0.35, END - 0.05);
  const sub = t >= w(13, 'If') - 0.1 ? 'If the server falls... everything resets!' : undefined;
  return G.alarmEdges(t, seg(t, tAlarm - 0.1, tAlarm + 0.3), { rate: 3.2 }) + G.systemBanner({ theme: 'alarm', text: 'WARNING!\nThe Block King has awakened!', sub, k, out, t, y: 170, s: 0.95 });
}
function shWarn(t) {
  const cam = shakeAll(camKeys(t, [[CUT.warn, { zoom: 2.3, x: 380, y: -50 }], [tKing, { zoom: 2.75, x: 438, y: -64 }], [CUT.faces, { zoom: 2.95, x: 440, y: -62 }]], ease.inOut), t, [[tAwake, 0.5, 10]]);
  const showKing = t >= tKing - 0.1;
  let o = bed(t, cam, { door: 0.9, tuck: 0.2, alarm: 1, clock: '11:00', ...(showKing ? { monitor: kingScreen(t) } : {}) }, { front: heroSitUp(t, { face: { name: 'scared', eyes: { look: [1, -0.1] } } }) + dadBed(t, { face: { name: 'shocked', eyes: { look: [1, -0.1] } }, turn: 0.35 }) });
  return o + banner(t);
}
// 32. "If the server falls..." — the two of them in the red light, scared
function shFaces(t) {
  const cam = camKeys(t, [[CUT.faces, { zoom: 1.75, x: -230, y: 20 }], [CUT.resets, { zoom: 1.88, x: -250, y: 16 }]], ease.inOut);
  const look = seg(t, w(13, 'falls') - 0.2, w(13, 'falls') + 0.2);
  const hero = heroSitUp(t, { turn: lerp(0.45, -0.1, look), face: { name: 'scared', eyes: { look: [lerp(1, 0.6, look), lerp(-0.1, -0.3, look)] }, fx: ['sweat'] } });
  const dd = dadBed(t, { face: { name: 'shocked', eyes: { look: [lerp(1, -0.8, look), -0.1] } }, turn: lerp(0.35, -0.3, look) });
  return bed(t, cam, { door: 0.9, tuck: 0.2, alarm: 1, clock: '11:00' }, { front: hero + dd }) + banner(t);
}
// 33. "...everything resets!" — the family's records crushed to zero: #1 -> #0, 9,999,999 -> 0, DAD -> LVL 1, LVL 99 -> 1
function shResets(t) {
  const u = seg(t, CUT.resets, CUT.final);
  const r = ease.inOut(seg(t, tResets - 0.15, tResets + 0.45));
  let o = S.rect(0, 0, 1920, 1080, 0, { fill: '#2A0610' }) + S.rect(0, 0, 1920, 1080, 0, { fill: '#FF1E3C', opacity: f(0.2 + 0.1 * Math.sin(t * 9)) });
  const tiles = [
    (x, y) => G.rankClimb({ x, y, from: 1, to: 999, roll: r, k: 1, t, s: 0.62, name: 'MOM_OFFICIAL' }),
    (x, y) => G.coinCounter({ x, y, s: 1.6, value: 0, from: 9999999, roll: r, t, anchor: 'center' }),
    (x, y) => G.nametag({ x, y, name: r > 0.5 ? 'DadBod1978' : 'DAD', level: r > 0.5 ? 1 : 99, col: r > 0.5 ? '#F2B705' : '#FF5FA8', crown: r <= 0.5, t, s: 2.2 }),
    (x, y) => G.levelBadge({ x, y, level: Math.round(lerp(99, 1, r)), t, s: 1.6, bump: seg(t, tResets, tResets + 0.45) }),
  ];
  const pos = [[520, 330], [1400, 330], [520, 760], [1400, 760]];
  tiles.forEach((fn, j) => {
    const k = seg(t, CUT.resets + j * 0.08, CUT.resets + j * 0.08 + 0.25);
    const [x, y] = pos[j];
    o += panel(x - 400, y - 190, 800, 380, S.rect(0, 0, 1920, 1080, 0, { fill: ['#3A1A5A', '#1A3A2A', '#5A1A3A', '#1A2A5A'][j] }), { k, rot: [-2, 2, 1, -1][j], border: 8, shadow: true });
    if (k > 0.3) o += fn(x, y);
  });
  // the glitch-out on "resets!"
  const gk = seg(t, tResets, tResets + 0.5);
  if (gk > 0) o += K.pixelBlocks(0, 0, 1920, 1080, t, gk * 0.8, '#151515', 80, 7);
  o += G.stamp({ text: 'RESET', k: seg(t, tResets + 0.15, tResets + 0.45), x: 960, y: 560, s: 1.2, rot: -8, col: '#FF3A4A', size: 170 });
  return o + banner(t) + G.flash ? o + banner(t) : o;
}
// 34. (beat) the hero's face in the red light: scared -> set. Red flash into SC 09.
function shFinal(t) {
  const u = seg(t, CUT.final, END);
  const cam = camKeys(t, [[CUT.final, camAt(HSIT.x + 20, 420, 2.5)], [END, camAt(HSIT.x + 20, 410, 3.1)]], ease.inOut);
  const det = seg(t, CUT.final + 0.8, CUT.final + 1.3);
  const hero = heroSitUp(t, { volume: false, turn: lerp(0.3, 0.05, det), face: det > 0.5 ? { name: 'determined', eyes: { look: [0.2, 0] } } : { name: 'scared', eyes: { look: [0.6, -0.1] } } });
  let o = bed(t, cam, { door: 0.9, tuck: 0.2, alarm: 1, clock: '11:00' }, { front: hero + dadBed(t, { face: { name: 'shocked', eyes: { look: [-0.9, -0.2] } }, turn: -0.3 }) });
  o += banner(t);
  return o + (t > END - 0.3 ? S.rect(0, 0, 1920, 1080, 0, { fill: '#FF2E4D', opacity: f(0.9 * seg(t, END - 0.3, END - 0.02)) }) : '');
}

// ================================================================= dispatch
const SHOTS = [
  [CUT.mom, shMom], [CUT.granny, shGranny], [CUT.dad, shDad], [CUT.behind, shBehind], [CUT.board, shBoard], [CUT.seethe, shSeethe], [CUT.slam, shSlam],
  [CUT.mygame, shMyGame], [CUT.friends, shFriends], [CUT.every, shEvery], [CUT.sweetie, shSweetie], [CUT.never, shNever], [CUT.stairs, shStairs],
  [CUT.silent, shSilent], [CUT.gtalk, shGTalk], [CUT.notyou, shNotYou], [CUT.him, shHim],
  [CUT.door, shDoor], [CUT.walk, shWalk], [CUT.care, shCare], [CUT.jump, shJump], [CUT.noob, shNoob], [CUT.year, shYear], [CUT.see, shSee],
  [CUT.asked, shAsked], [CUT.did, shDid], [CUT.notnow, shNotNow], [CUT.turn, shTurn], [CUT.clock, shClock], [CUT.alarm, shAlarm],
  [CUT.warn, shWarn], [CUT.faces, shFaces], [CUT.resets, shResets], [CUT.final, shFinal],
].sort((a, b) => a[0] - b[0]);
function shotAt(t) {
  let i = SHOTS.length - 1;
  while (i > 0 && t < SHOTS[i][0]) i--;
  return i;
}
function scene(t) {
  return SHOTS[shotAt(t)][1](t);
}
function look(t) {
  if (t >= CUT.board && t < CUT.seethe) return { grade: null, vignette: 0.55 };
  if (t >= CUT.resets && t < CUT.final) return { grade: null, vignette: 0.6 };
  if (t >= CUT.alarm) return { grade: 'night', vignette: 0.65 };
  if (t >= CUT.door) return { grade: 'night', vignette: 0.7 };
  if (t >= CUT.silent) return { grade: 'night', vignette: 0.65 };
  return { grade: 'night', vignette: 0.5 };
}
const DEFS = `<defs>
<linearGradient id="s08Cold" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#0A1030" stop-opacity="0.45"/><stop offset="0.45" stop-color="#0A1030" stop-opacity="0.15"/><stop offset="1" stop-color="#0A1030" stop-opacity="0"/></linearGradient>
</defs>`;
const BEATS = { T0, END, tSlam, tTurnFam, tFriends, tServer, tEvery, tJoined, tDoor, tGlass0, tGlassOff, tGlassDown, tHim, tOpen, tSit0, tSit1, tNoob, tWith, tHundred, tTimes, tRoll, tPM, tAlarm, tSitUp, tKing, tAwake, tResets, tSon, tBest, tRich, tFav };
module.exports = { scene, look, DEFS, SHOTS, CUT, BEATS, nnCount };
