{"id": "11", "model": "eleven_v4", "lines": [{"speaker": "NARRATOR", "text": "Dad. The man who couldn't jump. [pause] Versus one hundred floors of obby."}, {"speaker": "DAD", "text": "[nervous] Space... bar."}, {"speaker": "NARRATOR", "text": "He jumped. [pause] He jumped again. [pause] He slipped... and didn't fall."}, {"speaker": "NOODLE", "text": "[chanting] Jump, Dad! [pause] Jump, Dad!"}, {"speaker": "NARRATOR", "text": "And then the whole server started chanting."}, {"speaker": "DARKBLADE", "text": "[shouting] Jump, Mister Hot Dog! JUMP!"}, {"speaker": "DAD", "text": "[panicking] No no no no no... [pause] Okay. Okay! I'm okay!"}, {"speaker": "YOU", "text": "[shouting] JUMP, DAD, JUMP!"}, {"speaker": "DAD", "text": "[whispering] For my son."}, {"speaker": "BOSS", "text": "[booming, shocked] NO! [pause] Defeated... by a HOT DOG?!"}, {"speaker": "SYSTEM", "text": "[booming, triumphant] VICTORY! [pause] Server saved!"}, {"speaker": "MOM", "text": "[proud, shouting] That's my husband! [pause] THAT'S MY HUSBAND!"}, {"speaker": "DAD", "text": "[laughing, emotional] I did a jump! [pause] Son, I did a JUMP!"}, {"speaker": "YOU", "text": "[laughing] You did a HUNDRED jumps, Dad!"}, {"speaker": "SYSTEM", "text": "[cheerful] Most valuable player: DadBod1978."}], "voice_segments": [{"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 0.0, "end_time_seconds": 6.159999999999999, "character_start_index": 0, "character_end_index": 74, "dialogue_input_index": 0}, {"voice_id": "cjVigY5qzO86Huf0OWal", "start_time_seconds": 6.159999999999999, "end_time_seconds": 9.12, "character_start_index": 74, "character_end_index": 97, "dialogue_input_index": 1}, {"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 9.12, "end_time_seconds": 14.719999999999999, "character_start_index": 97, "character_end_index": 171, "dialogue_input_index": 2}, {"voice_id": "bIHbv24MWmeRgasZH58o", "start_time_seconds": 14.719999999999999, "end_time_seconds": 18.0, "character_start_index": 171, "char