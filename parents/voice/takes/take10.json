{"id": "10", "model": "eleven_v4", "lines": [{"speaker": "SYSTEM", "text": "[cheerful] Party formed. [pause] Party name: \"The Family.\""}, {"speaker": "YOU", "text": "[commanding] Okay! Mom, you're the tank. [pause] Granny, we need gear!"}, {"speaker": "GRANDMA", "text": "[proud] Swords for everyone! [pause] Put it on my tab!"}, {"speaker": "MOM", "text": "[battle cry] Kids! Formation! [pause] And wear your helmets!"}, {"speaker": "MOM", "text": "[fierce] Mommy's got you! [pause] Everybody behind me!"}, {"speaker": "NARRATOR", "text": "Mom blocked the punches. You led the attack. [pause] Even DarkBlade joined your team."}, {"speaker": "DARKBLADE", "text": "[grudging] Just this once."}, {"speaker": "GRANDMA", "text": "[shouting] Healing potions! A hundred of them! [pause] Family discount!"}, {"speaker": "YOU", "text": "[commanding] Noodle, left side! DarkBlade, right side! [pause] Everybody, ATTACK!"}, {"speaker": "BOSS", "text": "[booming, laughing] FOOLS! [pause] My shield cannot break!"}, {"speaker": "NOODLE", "text": "[urgent] The crystal! On top of the obby tower! [pause] Someone has to jump up there and break it!"}, {"speaker": "YOU", "text": "[panicked] I can't! If I leave, the whole team falls apart!"}, {"speaker": "NARRATOR", "text": "Everybody was fighting. [pause] Everybody... except one."}, {"speaker": "DAD", "text": "[quietly, determined] Son. [pause] I've been practicing."}], "voice_segments": [{"voice_id": "SAz9YHcvj6GT2YYXdXww", "start_time_seconds": 0.0, "end_time_seconds": 3.52, "character_start_index": 0, "character_end_index": 58, "dialogue_input_index": 0}, {"voice_id": "TX3LPaxmHKxFdv7VOQHJ", "start_time_seconds": 3.52, "end_time_seconds": 7.68, "character_start_index": 58, "character_end_index": 128, "dialogue_input_index": 1}, {"voice_id": "pFZP5JQG7iQjIQuC4Bku", "start_time_seconds": 7.68, "end_time_seconds": 11.200000000000001, "character_start_index": 128, "character_end_index": 182, "dialogue_input_index": 2}, {"voice_id": "XrExE9yKIg1Wjn