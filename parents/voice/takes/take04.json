{"id": "04", "model": "eleven_v4", "lines": [{"speaker": "SYSTEM", "text": "[cheerful] DadBod1978 joined the server. [pause] MOM_OFFICIAL joined the server. [pause] GrannyGoodies joined the server."}, {"speaker": "NARRATOR", "text": "The whole server saw it. [pause] Every. Single. Name."}, {"speaker": "DAD", "text": "[loud, typing slowly] HELLO SON. [pause] IT IS DAD. [pause] LOVE, DAD."}, {"speaker": "NOODLE", "text": "[laughing] Bro... is that your DAD?!"}, {"speaker": "YOU", "text": "[whispering, panicked] Rule number one, Dad! RULE NUMBER ONE!"}, {"speaker": "NARRATOR", "text": "Then Mom found the emote button."}, {"speaker": "MOM", "text": "[sweetly] Mwah! [pause] Love you, honey!"}, {"speaker": "DARKBLADE", "text": "[mocking] Ha! The legend brought his MOMMY."}, {"speaker": "DAD", "text": "[determined] Don't worry, son. Dad's got this. [pause] How do I jump?"}, {"speaker": "YOU", "text": "[whisper-shouting] Spacebar!"}, {"speaker": "DAD", "text": "[shouting at the screen] SPACE! [pause] BAR!"}, {"speaker": "NARRATOR", "text": "[deadpan] He did not press the spacebar. [pause] He said it. Very loudly. To the computer."}, {"speaker": "DAD", "text": "[typing slowly] DEAR EVERYONE. [pause] WHERE IS THE JUMP BUTTON."}, {"speaker": "NARRATOR", "text": "Fifty players answered at the same time. [pause] Fifty players said \"SPACEBAR.\""}, {"speaker": "YOU", "text": "[whispering] Nobody look at me. [pause] I'm a tree. I'm a tree."}], "voice_segments": [{"voice_id": "SAz9YHcvj6GT2YYXdXww", "start_time_seconds": 0.0, "end_time_seconds": 8.72, "character_start_index": 0, "character_end_index": 121, "dialogue_input_index": 0}, {"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 8.72, "end_time_seconds": 13.280000000000001, "character_start_index": 121, "character_end_index": 174, "dialogue_input_index": 1}, {"voice_id": "cjVigY5qzO86Huf0OWal", "start_time_seconds": 13.280000000000001, "end_time_seconds": 20.16, "character_start_index": 174, "character_end_index": 244,