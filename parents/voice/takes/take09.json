{"id": "09", "model": "eleven_v4", "lines": [{"speaker": "NARRATOR", "text": "The Block King. The biggest boss in Cube City history."}, {"speaker": "BOSS", "text": "[booming, echoing] CUBE CITY... [pause] IS MINE!"}, {"speaker": "NARRATOR", "text": "He smashed the arena. He smashed Tycoon Valley. [pause] He smashed Granny's cookie factory."}, {"speaker": "GRANDMA", "text": "[outraged] MY COOKIES!"}, {"speaker": "DARKBLADE", "text": "[panicked] Clan, attack! [pause] Clan? CLAN?!"}, {"speaker": "NOODLE", "text": "[panicked] Bro, where ARE you?! We need you!"}, {"speaker": "NARRATOR", "text": "The server health bar was dropping. [pause] Ninety percent. Fifty. [pause] Twenty."}, {"speaker": "YOU", "text": "[determined] Dad... [pause] I can't win this alone."}, {"speaker": "DAD", "text": "[warm] Then don't."}, {"speaker": "YOU", "text": "[urgent] Mom! Grandma! The server needs us!"}, {"speaker": "MOM", "text": "[stern] It's eleven p.m., young man. [pause] Bedtime."}, {"speaker": "MOM", "text": "[cold, focused] ...Five minutes. [pause] Let's go."}, {"speaker": "GRANDMA", "text": "[cracking knuckles] Granny's coming, dear."}, {"speaker": "NARRATOR", "text": "[epic] And for the first time ever... your whole family logged in. Together."}], "voice_segments": [{"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 0.0, "end_time_seconds": 4.08, "character_start_index": 0, "character_end_index": 54, "dialogue_input_index": 0}, {"voice_id": "pNInz6obpgDQGcFmaJgB", "start_time_seconds": 4.08, "end_time_seconds": 7.92, "character_start_index": 54, "character_end_index": 102, "dialogue_input_index": 1}, {"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 7.92, "end_time_seconds": 14.32, "character_start_index": 102, "character_end_index": 193, "dialogue_input_index": 2}, {"voice_id": "pFZP5JQG7iQjIQuC4Bku", "start_time_seconds": 14.32, "end_time_seconds": 15.8, "character_start_index": 193, "character_end_index": 215, "dialogue_input_index": 3}, {"voice_id": "N2lVS1w4Eto