{"id": "02b", "model": "eleven_v4", "lines": [{"speaker": "MAX", "text": "[tiny voice] I'm a T-rex! [pause] RAWR!"}, {"speaker": "NARRATOR", "text": "[warmly] And Biscuit. Biscuit is a very good boy. That's his whole job."}, {"speaker": "GRANDPA", "text": "[proud, old] Did I tell you about seventy-nine?"}, {"speaker": "YOU", "text": "[deadpan] Every day, Grandpa. [pause] Every. Single. Day."}, {"speaker": "NARRATOR", "text": "At school, there's Benji. Your best friend. [pause] He's bad at sports. Bad at math. Bad at shoelaces."}, {"speaker": "BENJI", "text": "[cheerful, nervous] I'm okay! [pause] I'm okay! I meant to do that!"}, {"speaker": "NARRATOR", "text": "[warmly] But he's the nicest person you know."}, {"speaker": "NARRATOR", "text": "And then there's Tank. [pause] Nobody knows much about Tank. [pause] Except that he's big. And he's always hungry."}, {"speaker": "TANK", "text": "[low, gruff] Lunch. [pause] Now."}, {"speaker": "YOU", "text": "[nervous] Sure. Yep. [pause] Enjoy. It's turkey."}, {"speaker": "BENJI", "text": "[whispering] One day, we'll stand up to him. [pause] Probably not today. But one day."}, {"speaker": "YOU", "text": "[frustrated] If only I knew how strong everyone REALLY was."}, {"speaker": "NARRATOR", "text": "[ominous] Be careful what you wish for."}], "voice_segments": [{"voice_id": "cgSgspJ2msm6clMCkdW9", "start_time_seconds": 0.0, "end_time_seconds": 3.04, "character_start_index": 0, "character_end_index": 39, "dialogue_input_index": 0}, {"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 3.04, "end_time_seconds": 8.24, "character_start_index": 39, "character_end_index": 110, "dialogue_input_index": 1}, {"voice_id": "pqHfZKP75CvOlQylNhV4", "start_time_seconds": 8.24, "end_time_seconds": 10.96, "character_start_index": 110, "character_end_index": 157, "dialogue_input_index": 2}, {"voice_id": "TX3LPaxmHKxFdv7VOQHJ", "start_time_seconds": 10.96, "end_time_seconds": 15.52, "character_start_index": 157, "character_end_index": 214, "