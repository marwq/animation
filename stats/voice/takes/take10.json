{"id": "10", "model": "eleven_v4", "lines": [{"speaker": "NARRATOR", "text": "[softly] No numbers. [pause] Just colors. And sounds. [pause] And faces."}, {"speaker": "NARRATOR", "text": "And you didn't need stats to know your brother."}, {"speaker": "YOU", "text": "[focused] Max loves dinosaurs. [pause] He says \"rawr\" at everything. [pause] And he always wants to be up high."}, {"speaker": "BENJI", "text": "[out of breath] I heard! I know the fair map! [pause] I've been here eleven times!"}, {"speaker": "TANK", "text": "[low, kind] I'm tall. [pause] Get on."}, {"speaker": "NARRATOR", "text": "You ran past the Ferris wheel. Past the cotton candy. [pause] Past the giant teacups."}, {"speaker": "NARRATOR", "text": "The kid with level four. The kid with three health. [pause] And you."}, {"speaker": "BENJI", "text": "[focused] Not the Ferris wheel. Max hates the Ferris wheel. It's too slow."}, {"speaker": "TANK", "text": "[low] Cotton candy? [pause] Every kid goes to cotton candy."}, {"speaker": "YOU", "text": "[thinking] No. [pause] Max doesn't want sweets. Max wants to be a DINOSAUR. [pause] Up high."}, {"speaker": "YOU", "text": "[shouting] THERE! On top of the dinosaur!"}, {"speaker": "MAX", "text": "[tiny voice, happy] RAWR!"}, {"speaker": "YOU", "text": "[relieved, laughing] Found you, T-rex."}, {"speaker": "MAX", "text": "[tiny voice, proud] I was the king of the dinosaurs! [pause] RAWR!"}, {"speaker": "MOM", "text": "[crying, happy] Don't you EVER do that again!"}, {"speaker": "MAX", "text": "[tiny voice] ...Can we do it again?"}], "voice_segments": [{"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 0.0, "end_time_seconds": 4.88, "character_start_index": 0, "character_end_index": 72, "dialogue_input_index": 0}, {"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 4.88, "end_time_seconds": 7.5600000000000005, "character_start_index": 72, "character_end_index": 119, "dialogue_input_index": 1}, {"voice_id": "TX3LPaxmHKxFdv7VOQHJ", "start_time_second