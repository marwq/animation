{"id": "02a", "model": "eleven_v4", "lines": [{"speaker": "NARRATOR", "text": "[storyteller] This is you. You love games. Because in games, everything makes sense."}, {"speaker": "NARRATOR", "text": "Every enemy has a level. Every item has stats. [pause] You always know who's strong."}, {"speaker": "YOU", "text": "[proud] Level fifty goblin? Easy. [pause] Level ninety dragon? Run."}, {"speaker": "NARRATOR", "text": "[sighs] But real life? Real life has no numbers. [pause] You never know what anyone is thinking."}, {"speaker": "NARRATOR", "text": "There's Mom. She runs a bakery. She works all day... and she always smiles."}, {"speaker": "MOM", "text": "[cheerful, tired] Morning, sweetheart! Breakfast is ready! [pause] Probably."}, {"speaker": "NARRATOR", "text": "She baked three hundred cupcakes before sunrise. [pause] And she still asked about your day."}, {"speaker": "NARRATOR", "text": "There's Grandpa Lou. Every breakfast, he tells the same story."}, {"speaker": "GRANDPA", "text": "[proud, old] Nineteen seventy-nine! The arm wrestling finals! I was a legend!"}, {"speaker": "NARRATOR", "text": "There's Max. Your little brother. He's five. [pause] He's basically a tornado in a dinosaur suit."}], "voice_segments": [{"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 0.0, "end_time_seconds": 5.76, "character_start_index": 0, "character_end_index": 84, "dialogue_input_index": 0}, {"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 5.76, "end_time_seconds": 11.68, "character_start_index": 84, "character_end_index": 168, "dialogue_input_index": 1}, {"voice_id": "TX3LPaxmHKxFdv7VOQHJ", "start_time_seconds": 11.68, "end_time_seconds": 16.64, "character_start_index": 168, "character_end_index": 235, "dialogue_input_index": 2}, {"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 16.64, "end_time_seconds": 23.439999999999998, "character_start_index": 235, "character_end_index": 331, "dialogue_input_index": 3}, {"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_