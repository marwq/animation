{"id": "09", "model": "eleven_v4", "lines": [{"speaker": "GRANDPA", "text": "[calm, old] Breathe, kid. [pause] Sit with me for one second."}, {"speaker": "GRANDPA", "text": "[warm] You know my story. Nineteen seventy-nine. The finals. [pause] But I never told you the end."}, {"speaker": "GRANDPA", "text": "[smiling] I lost. [pause] Lost the final. In front of everybody."}, {"speaker": "YOU", "text": "[surprised] You... LOST?"}, {"speaker": "GRANDPA", "text": "[laughing softly] Arm went down in two seconds. [pause] The whole town laughed."}, {"speaker": "GRANDPA", "text": "[warm] And that night, I met your grandma. [pause] Best loss of my whole life."}, {"speaker": "GRANDPA", "text": "[gently] Numbers tell you how strong somebody is. [pause] They don't tell you who they are."}, {"speaker": "YOU", "text": "[quietly] I think I stopped seeing people, Grandpa. [pause] I only saw numbers."}, {"speaker": "GRANDPA", "text": "[curious] Hey. What's that little X up in the corner?"}, {"speaker": "YOU", "text": "[stunned] ...An X?"}, {"speaker": "NARRATOR", "text": "[deadpan] It was on page one. [pause] Of four thousand, eight hundred and twelve."}, {"speaker": "SYSTEM", "text": "[calm] Reality HUD... off."}], "voice_segments": [{"voice_id": "pqHfZKP75CvOlQylNhV4", "start_time_seconds": 0.0, "end_time_seconds": 3.76, "character_start_index": 0, "character_end_index": 61, "dialogue_input_index": 0}, {"voice_id": "pqHfZKP75CvOlQylNhV4", "start_time_seconds": 3.76, "end_time_seconds": 10.959999999999999, "character_start_index": 61, "character_end_index": 159, "dialogue_input_index": 1}, {"voice_id": "pqHfZKP75CvOlQylNhV4", "start_time_seconds": 10.959999999999999, "end_time_seconds": 15.44, "character_start_index": 159, "character_end_index": 223, "dialogue_input_index": 2}, {"voice_id": "TX3LPaxmHKxFdv7VOQHJ", "start_time_seconds": 15.44, "end_time_seconds": 17.2, "character_start_index": 223, "character_end_index": 247, "dialogue_input_index": 3}, {"voice_id": "pqHfZKP75CvOlQyl