{"id": "06", "model": "eleven_v4", "lines": [{"speaker": "SYSTEM", "text": "Experience plus fifty! [pause] Level up!"}, {"speaker": "YOU", "text": "[excited] I'm leveling UP? [pause] For being NICE?!"}, {"speaker": "NARRATOR", "text": "So you went on a quest spree."}, {"speaker": "NARRATOR", "text": "You carried groceries. You complimented the lunch lady. [pause] You rescued a ball from a tree."}, {"speaker": "YOU", "text": "[cheerful, fast] Nice hat, Mrs. Wells! [pause] Great soup, lunch lady! [pause] Cool dog, random man!"}, {"speaker": "NARRATOR", "text": "Level two. Level five. Level twenty."}, {"speaker": "NARRATOR", "text": "Every day, you shared your lunch with Tank. [pause] Forty health. Sixty. Eighty."}, {"speaker": "TANK", "text": "[low, almost smiling] Your mom makes good sandwiches."}, {"speaker": "GRANDPA", "text": "[grumpy, old] Has anybody seen my glasses?"}, {"speaker": "YOU", "text": "[deadpan] Grandpa. [pause] They're on your head."}, {"speaker": "SYSTEM", "text": "[cheerful] Quest complete. [pause] Plus one experience."}, {"speaker": "NARRATOR", "text": "[deadpan] Easiest quest in history."}, {"speaker": "MAX", "text": "[tiny voice] Build me a pillow fort! The biggest one EVER!"}, {"speaker": "SYSTEM", "text": "[cheerful] Epic quest complete! [pause] Plus one hundred experience!"}, {"speaker": "NARRATOR", "text": "[slower] But slowly... you stopped helping people. [pause] You started helping points."}, {"speaker": "YOU", "text": "[dismissive] Two XP? [pause] Not worth it."}], "voice_segments": [{"voice_id": "SAz9YHcvj6GT2YYXdXww", "start_time_seconds": 0.0, "end_time_seconds": 3.6, "character_start_index": 0, "character_end_index": 40, "dialogue_input_index": 0}, {"voice_id": "TX3LPaxmHKxFdv7VOQHJ", "start_time_seconds": 3.6, "end_time_seconds": 7.04, "character_start_index": 40, "character_end_index": 91, "dialogue_input_index": 1}, {"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 7.04, "end_time_seconds": 9.32, "character_start_index":