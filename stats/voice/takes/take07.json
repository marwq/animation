{"id": "07", "model": "eleven_v4", "lines": [{"speaker": "TEACHER", "text": "[cold] Science fair. Partners. [pause] Choose wisely."}, {"speaker": "BENJI", "text": "[excited] Partners again? I have an idea! A potato battery!"}, {"speaker": "YOU", "text": "[awkward] Actually, Benji... I'm working with them. [pause] They have ninety-five intelligence."}, {"speaker": "BENJI", "text": "[hurt, quiet] Since when do you care about levels?"}, {"speaker": "NARRATOR", "text": "[quietly] That number hurt more than any other."}, {"speaker": "NARRATOR", "text": "Your new partners were very smart. [pause] They talked only about numbers. [pause] They never laughed once."}, {"speaker": "YOU", "text": "[quietly] ...This is boring."}, {"speaker": "NARRATOR", "text": "At home, Mom had a quest. [pause] \"Help Mom. Five XP.\""}, {"speaker": "YOU", "text": "[distracted] Sorry, Mom. Gotta go. [pause] There's a fifty-XP quest down the street."}, {"speaker": "MOM", "text": "[tired, smiling] It's okay, sweetheart. I'm fine."}, {"speaker": "NARRATOR", "text": "She said she was fine. [pause] Her energy said one percent."}, {"speaker": "GRANDPA", "text": "[quietly] Kid. [pause] What are you really looking at?"}, {"speaker": "YOU", "text": "[defensive] Stats, Grandpa. [pause] Stats don't lie."}, {"speaker": "GRANDPA", "text": "[quietly] Maybe not. [pause] But they don't tell the whole truth, either."}], "voice_segments": [{"voice_id": "Xb7hH8MSUJpSbSDYk0k2", "start_time_seconds": 0.0, "end_time_seconds": 4.493, "character_start_index": 0, "character_end_index": 53, "dialogue_input_index": 0}, {"voice_id": "bIHbv24MWmeRgasZH58o", "start_time_seconds": 4.493, "end_time_seconds": 8.56, "character_start_index": 53, "character_end_index": 112, "dialogue_input_index": 1}, {"voice_id": "TX3LPaxmHKxFdv7VOQHJ", "start_time_seconds": 8.56, "end_time_seconds": 13.987, "character_start_index": 112, "character_end_index": 207, "dialogue_input_index": 2}, {"voice_id": "bIHbv24MWmeRgasZH58o", "start_time_second