{"id": "08", "model": "eleven_v4", "lines": [{"speaker": "NARRATOR", "text": "Saturday. The town fair. [pause] Mom's first day off in a year."}, {"speaker": "MOM", "text": "[happy, tired] Everybody stay together, okay?"}, {"speaker": "MAX", "text": "[tiny voice, excited] I wanna go UP! Way up! [pause] Where the clouds are!"}, {"speaker": "NARRATOR", "text": "Max wanted to go up. [pause] Remember that. It's important."}, {"speaker": "NARRATOR", "text": "But there were thousands of people. [pause] And thousands of numbers."}, {"speaker": "YOU", "text": "[worried] Wait. [pause] Where's Max?"}, {"speaker": "MOM", "text": "[panicked] Max? MAX!"}, {"speaker": "SYSTEM", "text": "[glitchy] New quest. [pause] Find Max. [pause] Location... unknown."}, {"speaker": "SYSTEM", "text": "[glitchy, alarm] Warning. Too many players. [pause] HUD overload."}, {"speaker": "NARRATOR", "text": "[tense] You looked everywhere. But all you could see... were numbers."}, {"speaker": "YOU", "text": "[panicked] Level twelve! Level forty! Level eight! [pause] I can't see FACES!"}, {"speaker": "MOM", "text": "[panicked] He's wearing a dinosaur suit! [pause] A green dinosaur!"}, {"speaker": "YOU", "text": "[panicked] I can't tell! Everybody's just... a number!"}, {"speaker": "NARRATOR", "text": "[quietly] You could see everyone's stats. [pause] But you couldn't see your brother."}], "voice_segments": [{"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 0.0, "end_time_seconds": 6.280000000000001, "character_start_index": 0, "character_end_index": 63, "dialogue_input_index": 0}, {"voice_id": "EXAVITQu4vr4xnSDxMaL", "start_time_seconds": 6.280000000000001, "end_time_seconds": 8.895000000000001, "character_start_index": 63, "character_end_index": 108, "dialogue_input_index": 1}, {"voice_id": "cgSgspJ2msm6clMCkdW9", "start_time_seconds": 8.895000000000001, "end_time_seconds": 13.360000000000003, "character_start_index": 108, "character_end_index": 182, "dialogue_input_index": 2}, {"voice_id": "JB