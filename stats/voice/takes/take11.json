{"id": "11", "model": "eleven_v4", "lines": [{"speaker": "NARRATOR", "text": "The next morning, you made breakfast. [pause] Without checking anyone's energy."}, {"speaker": "YOU", "text": "[warm] Sit down, Mom. [pause] I can see you're tired. [pause] With my eyes."}, {"speaker": "MOM", "text": "[touched] ...Thank you, sweetheart."}, {"speaker": "BENJI", "text": "[excited] It works! [pause] Kind of! A little!"}, {"speaker": "YOU", "text": "[laughing] Best partner ever."}, {"speaker": "YOU", "text": "[sincere] Benji... I'm sorry. [pause] You're not level four. You're my best friend."}, {"speaker": "BENJI", "text": "[touched] Thanks. [pause] ...Level four is still pretty good though, right?"}, {"speaker": "TANK", "text": "[shy] Can I... sit here?"}, {"speaker": "YOU", "text": "[cheerful] Always."}, {"speaker": "TANK", "text": "[shy, smiling] I brought my own lunch today. [pause] My dad made it. [pause] It's... mostly ketchup."}, {"speaker": "GRANDPA", "text": "[warm, old] Told you, kid. [pause] Best things in life don't have numbers."}, {"speaker": "NARRATOR", "text": "You turned the HUD on one last time. [pause] Just to check one thing."}], "voice_segments": [{"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 0.0, "end_time_seconds": 4.8, "character_start_index": 0, "character_end_index": 79, "dialogue_input_index": 0}, {"voice_id": "TX3LPaxmHKxFdv7VOQHJ", "start_time_seconds": 4.8, "end_time_seconds": 9.8, "character_start_index": 79, "character_end_index": 154, "dialogue_input_index": 1}, {"voice_id": "EXAVITQu4vr4xnSDxMaL", "start_time_seconds": 9.8, "end_time_seconds": 11.6, "character_start_index": 154, "character_end_index": 189, "dialogue_input_index": 2}, {"voice_id": "bIHbv24MWmeRgasZH58o", "start_time_seconds": 11.6, "end_time_seconds": 14.88, "character_start_index": 189, "character_end_index": 235, "dialogue_input_index": 3}, {"voice_id": "TX3LPaxmHKxFdv7VOQHJ", "start_time_seconds": 14.88, "end_time_seconds": 16.96, "character_start_index": 235, "