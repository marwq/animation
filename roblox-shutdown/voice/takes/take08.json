{"id": "08", "model": "eleven_v4", "lines": [{"speaker": "JUNO", "text": "Floor one. The Cooling Room. Where the servers chill out."}, {"speaker": "DEX", "text": "[screaming] No respawn! No respawn! NO RESPAWN!"}, {"speaker": "GRANDPA", "text": "[cheerful] Thirty years of mopping, kid! Bend your knees!"}, {"speaker": "PIP", "text": "[giggling] Ding!"}, {"speaker": "JUNO", "text": "Floor two. The Cable Jungle."}, {"speaker": "DEX", "text": "[scared] Juno, I can't. That's a real gap. With real... falling."}, {"speaker": "JUNO", "text": "[warm] Dex. Look at it. Platforms. Swinging ropes. A gap. [pause] What does that look like?"}, {"speaker": "DEX", "text": "[slowly realizing] ...It's an obby. [excited] It's just an OBBY!"}, {"speaker": "DEX", "text": "[hyped] Twelve thousand hours of practice, BABY!"}, {"speaker": "JUNO", "text": "Floor two and a half. The Lost and Found. Every item anyone ever lost in a game."}, {"speaker": "DEX", "text": "[gasps, excited] My first sword! I lost it in third grade!"}, {"speaker": "PIP", "text": "[happy] Ding!"}, {"speaker": "JUNO", "text": "[awed, whispering] Floor three. The Archive."}, {"speaker": "GRANDPA", "text": "[warm] Every game anyone ever made... is kept here. Every single one."}, {"speaker": "JUNO", "text": "[touched] Even mine."}, {"speaker": "GRANDPA", "text": "[gentle] Especially yours. Every world someone builds with love... gets a shelf."}, {"speaker": "JUNO", "text": "[quiet] I always thought my game didn't matter. Three visits. [pause] But somebody kept it anyway."}, {"speaker": "GRANDPA", "text": "[warm] A game doesn't need a million visits to matter, Juno. It just needs someone who made it."}, {"speaker": "JUNO", "text": "[scared] But at the end of the hall... the bubbles were turning grey."}], "voice_segments": [{"voice_id": "cgSgspJ2msm6clMCkdW9", "start_time_seconds": 0.0, "end_time_seconds": 4.32, "character_start_index": 0, "character_end_index": 57, "dialogue_input_index": 0}, {"voice_id": "TX3LPaxmHKxFdv7VOQ