{"id": "10", "model": "eleven_v4", "lines": [{"speaker": "LAG", "text": "[slow, deep, glitchy] One... min... min... minute... left."}, {"speaker": "JUNO", "text": "[shouting] Pip! Press the button!"}, {"speaker": "PIP", "text": "[cheerful, tiny] Ding!"}, {"speaker": "JUNO", "text": "[nervous, then sincere] Um. Hi. I'm Juno. I'm eleven. I'm... a builder."}, {"speaker": "JUNO", "text": "I know it's the last day. I know you want to play every single second. Me too."}, {"speaker": "JUNO", "text": "But there's a monster eating our servers. And he eats when we all rush."}, {"speaker": "JUNO", "text": "[sincere] We can play tomorrow. And the day after. But only if we stop... right now."}, {"speaker": "JUNO", "text": "[softly, sincere] So please... just for ten seconds... put down your phone. Log off. [pause] And look up."}, {"speaker": "STREAMER", "text": "[quiet, sincere] Chat... I'll be right back."}, {"speaker": "JUNO", "text": "[softly] And then... one by one... the world logged off."}, {"speaker": "SYSTEM", "text": "[robotic] Players online: eight hundred million..."}, {"speaker": "SYSTEM", "text": "[robotic] Ten million... ten thousand... ten..."}, {"speaker": "LAG", "text": "[panicking, slow] No... no... come... back... play... one... more..."}, {"speaker": "SYSTEM", "text": "[quiet] Players online... zero."}, {"speaker": "DEX", "text": "[whispering, amazed] ...The Touch Grass badge."}], "voice_segments": [{"voice_id": "pNInz6obpgDQGcFmaJgB", "start_time_seconds": 0.0, "end_time_seconds": 4.88, "character_start_index": 0, "character_end_index": 58, "dialogue_input_index": 0}, {"voice_id": "cgSgspJ2msm6clMCkdW9", "start_time_seconds": 4.88, "end_time_seconds": 7.04, "character_start_index": 58, "character_end_index": 91, "dialogue_input_index": 1}, {"voice_id": "FGY2WhTYpPnrIDTdsKH5", "start_time_seconds": 7.04, "end_time_seconds": 7.92, "character_start_index": 91, "character_end_index": 113, "dialogue_input_index": 2}, {"voice_id": "cgSgspJ2msm6clMCkdW9", "start_ti