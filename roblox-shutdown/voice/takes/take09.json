{"id": "09", "model": "eleven_v4", "lines": [{"speaker": "LAG", "text": "[booming, slow, glitchy] More... players... more... rushing... MORE... FOOD."}, {"speaker": "JUNO", "text": "[whispering] Every player on Earth was rushing to play one last game. And every one of them... was feeding him."}, {"speaker": "DEX", "text": "[cocky] Stand back. I've beaten every boss in Roblox."}, {"speaker": "JUNO", "text": "Dex, wait\u2014"}, {"speaker": "DEX", "text": "[muffled, groans] ...Real life is SO badly designed."}, {"speaker": "LAG", "text": "[laughing slowly, glitchy] Ha. [pause] Ha. [pause] Ha. [pause] Ha."}, {"speaker": "LAG", "text": "[slow, booming] Tomorrow... no more... games. No more... obbies. No more... elevators."}, {"speaker": "PIP", "text": "[angry, tiny] ...Not the elevator."}, {"speaker": "JUNO", "text": "[determined] My turn. I'm a BUILDER!"}, {"speaker": "LAG", "text": "[slow, mocking] Wall... not... loaded."}, {"speaker": "JUNO", "text": "[annoyed] Oh, come ON!"}, {"speaker": "SYSTEM", "text": "[calm, robotic] Shutdown in five minutes. Thanks for playing! Smiley face."}, {"speaker": "GRANDPA", "text": "[shocked] My mop! He ate my MOP!"}, {"speaker": "JUNO", "text": "[thinking out loud] Grandpa... you said he eats traffic. Everybody rushing at once."}, {"speaker": "JUNO", "text": "[slowly, realizing] What if there was NO traffic? Not forever. Just for... ten seconds?"}, {"speaker": "GRANDPA", "text": "[realizing] If every single player logged off at the same time... he'd have nothing to eat."}, {"speaker": "DEX", "text": "[disbelief] Juno! Nobody logs off! Not on the LAST DAY!"}, {"speaker": "JUNO", "text": "[determined] Then we ask. Everyone. At once."}], "voice_segments": [{"voice_id": "pNInz6obpgDQGcFmaJgB", "start_time_seconds": 0.0, "end_time_seconds": 6.0, "character_start_index": 0, "character_end_index": 76, "dialogue_input_index": 0}, {"voice_id": "cgSgspJ2msm6clMCkdW9", "start_time_seconds": 6.0, "end_time_seconds": 12.96, "character_start_index"