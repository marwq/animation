{"id": "03", "model": "eleven_v4", "lines": [{"speaker": "JUNO", "text": "[storyteller] It was a normal Tuesday. Six p.m. Peak gaming hour."}, {"speaker": "JUNO", "text": "And then... every screen in the world... showed the same message."}, {"speaker": "SYSTEM", "text": "[calm, polite, robotic] Attention, players. Roblox will shut down forever... in twenty-four hours."}, {"speaker": "SYSTEM", "text": "[cheerful] Thanks for playing! Smiley face."}, {"speaker": "DEX", "text": "[devastated, screaming] FOREVER?! Like... FOREVER forever?!"}, {"speaker": "DEX", "text": "[sobbing] I have a nine-hundred-day login streak!"}, {"speaker": "PIP", "text": "[small, sad] ...Even the elevator?"}, {"speaker": "DAD", "text": "[nervous, whispering] It's fine. It's just a game. [pause] ...Not my fish. Please, not my fish."}, {"speaker": "JUNO", "text": "[panicked] My game isn't finished! Bubble Island has no ending! The bubbles don't even POP yet!"}, {"speaker": "ANCHOR", "text": "[dramatic, news] Breaking news! The world has entered... the Final Twenty-Four Hours!"}, {"speaker": "ANCHOR", "text": "Schools are closed. Parents are confused. And one kid has already fainted. [pause] Twice."}, {"speaker": "ANCHOR", "text": "[dramatic] Ten thousand players are trying to beat the same obby at the same time. [pause] And a dog has learned to say \"oof.\""}, {"speaker": "ANCHOR", "text": "[serious] Experts say the shutdown cannot be stopped. [pause] Experts also say they're going to go play now. Goodbye!"}, {"speaker": "JUNO", "text": "The countdown started. And the whole world... went a little bit crazy."}], "voice_segments": [{"voice_id": "cgSgspJ2msm6clMCkdW9", "start_time_seconds": 0.0, "end_time_seconds": 3.9600000000000004, "character_start_index": 0, "character_end_index": 65, "dialogue_input_index": 0}, {"voice_id": "cgSgspJ2msm6clMCkdW9", "start_time_seconds": 3.9600000000000004, "end_time_seconds": 9.280000000000001, "character_start_index": 65, "character_end_index": 130, "dialogue_i