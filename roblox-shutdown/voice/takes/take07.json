{"id": "07", "model": "eleven_v4", "lines": [{"speaker": "JUNO", "text": "[awed] The Server Farm. Every game. Every avatar. Every obby ever made. All in one building."}, {"speaker": "GRANDPA", "text": "[nostalgic, warm] Thirty years... and she hasn't changed a bit."}, {"speaker": "GRANDPA", "text": "[offended] Expired?! I mopped these floors for thirty years!"}, {"speaker": "MODBOT", "text": "[robotic, stern] Intruders detected! Leave now, or you will be... beep beep beep beep!"}, {"speaker": "DEX", "text": "[scared] Did that robot just get chat-filtered?!"}, {"speaker": "GRANDPA", "text": "[fake robot voice, badly] Beep. Boop. I am... also a robot. Nothing to see here."}, {"speaker": "MODBOT", "text": "[robotic, suspicious] ...Welcome, colleague."}, {"speaker": "DEX", "text": "[whispering, amazed] That should NOT have worked."}, {"speaker": "DEX", "text": "[sneezing] Ah... ah... ACHOO!"}, {"speaker": "MODBOT", "text": "[robotic, alarmed] Intruders! Intruders! Beep beep beep!"}, {"speaker": "JUNO", "text": "[panicked] A service elevator with four hundred buttons! Nobody knows which one\u2014"}, {"speaker": "PIP", "text": "[calm, expert] Basement nine. Then up two. Then hold \"close door\" for three seconds."}, {"speaker": "PIP", "text": "[proud] Ding!"}, {"speaker": "JUNO", "text": "[amazed] Forty-one thousand elevator rides... and they finally paid off."}, {"speaker": "GRANDPA", "text": "[impressed, warm] That's my grandson."}, {"speaker": "PIP", "text": "[whispering] Ding."}], "voice_segments": [{"voice_id": "cgSgspJ2msm6clMCkdW9", "start_time_seconds": 0.0, "end_time_seconds": 8.811, "character_start_index": 0, "character_end_index": 92, "dialogue_input_index": 0}, {"voice_id": "pqHfZKP75CvOlQylNhV4", "start_time_seconds": 8.811, "end_time_seconds": 12.36, "character_start_index": 92, "character_end_index": 155, "dialogue_input_index": 1}, {"voice_id": "pqHfZKP75CvOlQylNhV4", "start_time_seconds": 12.36, "end_time_seconds": 16.582, "character_start_index": 155, "