 "captions": [
  [0.8, 3.6, "Times Square, New York. 7:12 PM."],
  [4.4, 6.9, "Yellow cabs. Giant screens. Crowds."],
  [8.6, 10.8, "The crossroads of the world."],
  [11.3, 13.2, "Then the manhole cover under you shifts."],
  [13.9, 15.7, "It's sinking. And you're on it."],
  [17.4, 19.2, "The city above you, getting smaller."],
  [20.5, 22.2, "Under New York: 7,400 miles of sewers."],
  [23.4, 26.0, "Steam pipes. Water mains. Cables."],
  [27.0, 30.0, "Nearly 7,000 miles of water mains feed the city."],
  [30.8, 33.8, "And America's biggest steam system."],
  [36.8, 39.6, "The subway. Straight through it."],
  [40.2, 42.0, "Something's coming."],
  [43.6, 46.4, "Over three million subway rides a day."],
  [47.8, 50.8, "Then bedrock, older than the dinosaurs."],
  [52.5, 55.5, "Manhattan schist. About 450 million years old."],
  [57.5, 60.5, "Those red specks? Garnets."],
  [63.0, 66.0, "This rock was once mud on an ancient ocean floor."],
  [68.5, 71.5, "Groundwater seeps through the cracks."],
  [75.0, 78.0, "55 metres. Deeper than any subway station in New York."],
  [81.5, 84.5, "Midtown's skyscrapers are anchored in this rock."],
  [88.0, 91.0, "93 metres. The Statue of Liberty would fit above you."],
  [94.0, 97.0, "Down here it's 15 °C, summer or winter."],
  [100.0, 103.0, "Even here, microbes live inside the rock."],
  [106.0, 109.0, "Something's below you."],
  [111.0, 114.0, "A water tunnel, 180 metres down."],
  [116.0, 119.2, "New York's drinking water rushes through it."],
  [121.2, 124.6, "City Water Tunnel No. 3. Begun in 1970. Still not finished."],
  [131.0, 134.0, "The rock was folded like dough when landmasses collided."],
  [137.0, 140.0, "Faster now: almost ten metres every second."],
  [146.2, 149.2, "Fordham gneiss. Over a billion years old."],
  [150.6, 153.6, "443 m. Deeper than the Empire State Building is tall."],
  [156.8, 159.8, "541 m. Deeper than One World Trade Center is tall."],
  [161.2, 164.2, "This rock formed before animals existed."],
  [165.4, 168.4, "It's getting warm: +2.5 °C every 100 metres."],
  [170.1, 173.1, "828 m. Deeper than the Burj Khalifa is tall."],
  [175.8, 179.4, "One kilometre down. 12,741 to go."]
 ],
