 "float": [[0, 0], [694.5, 0], [697.5, 1], [709.5, 1], [713, 0.25], [835, 0.25], [838, 0.45], [899.5, 0.45], [900.5, 0], [930, 0]],
 "tread": [[0, 0], [899.5, 0], [901.5, 1], [930, 1]],
 "captions": [
  [0.8, 3.6, "Times Square, New York. 7:12 PM."],
  [4.4, 6.9, "Yellow cabs. Giant screens. Crowds."],
  [8.6, 10.8, "The crossroads of the world."],
  [11.3, 13.2, "Then the manhole cover under you shifts."],
  [13.9, 15.7, "It's sinking. And you're on it."],
  [17.4, 19.2, "The city above you, getting smaller."],
  [20.5, 22.2, "Under New York: 7,400 miles of sewers."],
  [23.4, 26.0, "Steam pipes. Water mains. Cables."],
  [27.0, 30.0, "Nearly 7,000 miles of water mains feed the city."],
  [30.8, 33.8, "And America's biggest steam system."],
  [36.8, 39.6, "The subway. Straight through it."],
  [40.2, 42.0, "Something's coming."],
  [43.6, 46.4, "Over three million subway rides a day."],
  [47.8, 50.8, "Then bedrock, older than the dinosaurs."],
  [52.5, 55.5, "Manhattan schist. About 450 million years old."],
  [57.5, 60.5, "Those red specks? Garnets."],
  [63.0, 66.0, "This rock was once mud on an ancient ocean floor."],
  [68.5, 71.5, "Groundwater seeps through the cracks."],
  [75.0, 78.0, "55 metres. Deeper than any subway station in New York."],
  [81.5, 84.5, "Midtown's skyscrapers are anchored in this rock."],
  [88.0, 91.0, "93 metres. The Statue of Liberty would fit above you."],
  [94.0, 97.0, "Down here it's 15 °C, summer or winter."],
  [100.0, 103.0, "Even here, microbes live inside the rock."],
  [106.0, 109.0, "Something's below you."],
  [111.0, 114.0, "A water tunnel, 180 metres down."],
  [116.0, 119.2, "New York's drinking water rushes through it."],
  [121.2, 124.6, "City Water Tunnel No. 3. Begun in 1970. Still not finished."],
  [131.0, 134.0, "The rock was folded like dough when landmasses collided."],
  [137.0, 140.0, "Faster now: almost ten metres every second."],
  [146.2, 149.2, "Fordham gneiss. Over a billion years old."],
  [150.6, 153.6, "443 m. Deeper than the Empire State Building is tall."],
  [156.8, 159.8, "541 m. Deeper than One World Trade Center is tall."],
  [161.2, 164.2, "This rock formed before animals existed."],
  [165.4, 168.4, "It's getting warm: +2.5 °C every 100 metres."],
  [170.1, 173.1, "828 m. Deeper than the Burj Khalifa is tall."],
  [175.8, 179.4, "One kilometre down. 12,741 to go."],
  [183.5, 186.5, "The rock here is squeezed by over 300 atmospheres."],
  [189.5, 192.5, "Falling at 130 km/h now."],
  [200.3, 203.3, "1,857 m. As deep as the Grand Canyon."],
  [207.5, 210.5, "2,212 m. Deeper than the deepest known cave on Earth."],
  [213.5, 216.5, "Bacteria have been found living almost 3 km down."],
  [220.1, 223.1, "3 km. The rock is 85 °C. Hot enough to scald."],
  [226.0, 229.0, "These are the roots of mountains that wore away long ago."],
  [232.0, 235.0, "4 km. The deepest mines on Earth stop here."],
  [236.5, 239.5, "Miners there survive on ice-cold air pumped down from the surface."],
  [243.6, 246.6, "5 km. Falling at 350 km/h."],
  [250.5, 253.5, "Water still seeps through hair-thin cracks."],
  [257.0, 260.0, "Most earthquakes start at this depth: 5 to 15 km down."],
  [264.0, 267.0, "This pressure would crush a submarine like a soda can."],
  [273.1, 276.1, "8,849 m. Mount Everest would fit above you."],
  [279.0, 282.0, "The rock is 200 °C."],
  [284.1, 287.1, "10,935 m. Deeper than the deepest point of the ocean."],
  [290.0, 293.0, "12,262 m. The deepest hole ever drilled stopped here."],
  [293.5, 296.5, "The Kola Superdeep Borehole, 1989. The rock was 180 °C."],
  [300.0, 303.0, "Nothing humans have built has ever gone deeper."],
  [306.0, 309.0, "15 km. The rock starts to flow, like warm wax."],
  [312.0, 315.0, "The lower crust: dark, dense rock called granulite."],
  [317.3, 320.3, "20 km. Pressure: 5,000 times the air at the surface."],
  [324.0, 327.0, "400 °C. Hot enough to melt lead."],
  [331.0, 334.0, "Look closer."],
  [335.5, 338.5, "550 °C. The rock is starting to glow."],
  [341.0, 344.0, "You'd have been crushed long ago. Let's keep going."],
  [346.0, 349.0, "Something's changing."],
  [350.0, 353.0, "36 km. The Moho: the bottom of the crust."],
  [353.5, 356.5, "Below it: the mantle. 84% of Earth's volume."],
  [359.0, 362.0, "Green rock: peridotite, made mostly of olivine."],
  [364.7, 367.7, "50 km. Gem-quality olivine is called peridot."],
  [371.0, 374.0, "It's 800 °C. Glowing cherry red."],
  [377.0, 380.0, "Falling at 5,300 km/h."],
  [383.0, 386.0, "Somewhere above, New York is having a quiet evening."],
  [395.7, 398.7, "100 km. The bottom of the tectonic plate."],
  [399.5, 402.5, "Below it, the rock is soft enough to flow. Plates slide on top."],
  [406.0, 409.0, "Tiny drops of melt glow between the crystals."],
  [413.8, 416.8, "150 km. This is where diamonds form."],
  [418.0, 421.0, "Carbon, crushed at 1,200 °C. Most are billions of years old."],
  [423.0, 426.0, "Volcanic pipes called kimberlites carry them up."],
  [430.0, 433.0, "Deep earthquakes can strike as far down as 700 km."],
  [437.0, 440.0, "1,400 °C. Solid rock, but it moves."],
  [444.8, 447.8, "300 km. The mantle churns like a pot on a stove."],
  [451.0, 454.0, "Very slowly: about as fast as your fingernails grow."],
  [458.7, 461.7, "410 km. The olivine crushes into a denser crystal."],
  [462.5, 465.5, "Welcome to the transition zone."],
  [469.3, 472.3, "Ringwoodite: a blue mineral that traps water in its crystals."],
  [473.5, 476.5, "This layer may hold as much water as all the oceans."],
  [480.0, 483.0, "660 km. The lower mantle begins."],
  [484.0, 487.0, "Bridgmanite: the most common mineral on Earth. It only exists this deep."],
  [491.0, 494.0, "Pressure: 300,000 atmospheres."],
  [498.3, 501.3, "1,000 km down. Falling at 82,000 km/h."],
  [505.0, 508.0, "Slabs of ancient ocean floor sink this deep and pile up."],
  [511.0, 514.0, "Some sank here when dinosaurs were alive."],
  [516.1, 519.1, "1,500 km. 2,500 °C."],
  [528.8, 531.8, "2,000 km. Almost a third of the way to the centre."],
  [535.0, 538.0, "Ahead: the strangest layer in the mantle."],
  [541.5, 544.5, "D″: a rough, patchy layer right above the core."],
  [545.0, 548.0, "2,890 km. The core."],
  [548.5, 551.5, "Liquid iron and nickel. 4,000 °C."],
  [555.0, 558.0, "Density jumps more here than from air to ground."],
  [562.0, 565.0, "This ocean of metal swirls as Earth spins."],
  [569.0, 572.0, "Its currents create Earth's magnetic field."],
  [576.5, 579.5, "That's why a compass points north."],
  [583.0, 586.0, "And why auroras light up the polar skies."],
  [590.0, 593.0, "The core is bigger than the planet Mars."],
  [598.4, 601.4, "4,000 km down. 4,500 °C."],
  [605.0, 608.0, "Here the iron flows about 15 km a year."],
  [612.0, 615.0, "Faster than anything else inside the planet."],
  [618.8, 621.8, "4,500 km. Earth's magnetic field has flipped hundreds of times."],
  [625.0, 628.0, "The last time: 780,000 years ago."],
  [632.0, 635.0, "Below you: something solid."],
  [640.0, 643.0, "5,150 km. The inner core."],
  [643.5, 646.5, "A ball of solid iron, as hot as the surface of the Sun."],
  [650.0, 653.0, "It stays solid only because of the pressure: 3.6 million atmospheres."],
  [657.0, 660.0, "It's growing about 1 mm a year as Earth slowly cools."],
  [664.0, 667.0, "Its iron crystals may line up from pole to pole."],
  [671.0, 674.0, "You're slowing down."],
  [679.0, 682.0, "Gravity is fading. The whole planet pulls on you equally."],
  [686.0, 689.0, "Almost there."],
  [692.0, 695.5, "6,371 km. The centre of the Earth."],
  [697.0, 700.0, "Gravity: zero. You're weightless."],
  [701.5, 704.5, "Halfway."],
  [705.0, 708.0, "Past the centre, 'down' flips. Now you rise."],
  [711.0, 714.0, "Every metre from here takes you up."],
  [717.0, 720.0, "Straight through, from New York to the other side of the world."],
  [724.0, 727.0, "Rising through the inner core. Faster now."],
  [731.0, 734.0, "Above you: liquid iron again."],
  [738.0, 741.0, "The outer core. 5,000 °C."],
  [745.0, 748.0, "Which spot on Earth is exactly opposite Times Square?"],
  [752.0, 755.0, "Not China. Not Australia."],
  [760.0, 763.0, "The mantle. Back in solid rock."],
  [767.0, 770.0, "Most places on Earth have ocean on the opposite side."],
  [774.0, 777.0, "And so does New York."],
  [781.0, 784.0, "660 km. The transition zone again: blue ringwoodite."],
  [786.5, 789.5, "410 km. Green olivine."],
  [792.0, 795.0, "The rock around you is cooling."],
  [799.0, 802.0, "This side's tectonic plate is thinner: young ocean floor."],
  [805.0, 808.0, "Above you: the southern Indian Ocean."],
  [815.0, 818.0, "11 km. The Moho again. Then oceanic crust, just 7 km thick."],
  [819.0, 822.0, "Gabbro: magma that cooled slowly under a mid-ocean ridge."],
  [823.5, 826.5, "Then sheeted dikes: frozen cracks where lava once rose."],
  [827.5, 830.5, "Pillow lava: blobs of basalt that erupted underwater."],
  [831.5, 834.5, "And on top: mud made of tiny shells."],
  [835.5, 838.5, "4,321 metres under the sea."],
  [839.5, 842.5, "1 °C. Pressure: 430 times the air."],
  [843.5, 846.5, "The abyss covers more of Earth than all the land."],
  [849.0, 852.0, "Pitch black. Sunlight never reaches here."],
  [853.0, 855.6, "But not lifeless."],
  [857.0, 860.0, "A siphonophore: a colony of tiny animals glowing as one."],
  [862.5, 865.5, "Three out of four deep-sea animals make their own light."],
  [867.0, 869.8, "Something big is coming."],
  [870.5, 873.5, "A sperm whale, hunting squid 1,700 m down."],
  [874.5, 877.5, "It can hold its breath for over an hour."],
  [879.0, 882.0, "1,000 m. The faintest trace of sunlight."],
  [884.0, 887.0, "Lanternfish: maybe the most numerous animals with a backbone."],
  [889.5, 892.5, "200 m. The sunlit ocean."],
  [893.5, 896.1, "Almost there."],
  [901.5, 904.5, "40.76° South, 106.01° East."],
  [905.5, 908.5, "The exact opposite side of the world from Times Square."],
  [910.0, 913.0, "The nearest land: Australia, 1,070 km away."],
  [914.5, 917.5, "At home it's 7:27 PM. Here, 6:30 tomorrow morning."],
  [919.0, 922.5, "You fell 12,742 km in 15 minutes."]
 ],
