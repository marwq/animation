{"id": "10", "model": "eleven_v4", "lines": [{"speaker": "NARRATOR", "text": "Friday night. The whole school was there. [pause] And every act before yours... was perfect."}, {"speaker": "NARRATOR", "text": "Dad came. Mom came straight from her shift. [pause] And Bea made a sign."}, {"speaker": "PRINCIPAL", "text": "[announcing] And next... Ivy and... [pause] you! With \"Science Magic\"!"}, {"speaker": "NARRATOR", "text": "No checkpoint. No reset. No pause menu. [pause] Just you... and four hundred people."}, {"speaker": "YOU", "text": "[nervous, whispering] Okay. One try. Only one try."}, {"speaker": "IVY", "text": "[dramatic] Ladies and gentlemen! From this ordinary hat, I will now pull out\u2014"}, {"speaker": "NARRATOR", "text": "And of course... you messed up."}, {"speaker": "YOU", "text": "[whispering, frozen] Reset... reset... RESET!"}, {"speaker": "IVY", "text": "[whispering, grinning] Fail number three hundred and thirteen. [pause] Let's make it a good one."}, {"speaker": "NARRATOR", "text": "So you did something you had never done before. [pause] You kept going."}, {"speaker": "KID", "text": "[chanting] FOAM! FOAM! FOAM! FOAM!"}, {"speaker": "MOM", "text": "[cheering, laughing] I'm sending this to the WHOLE family!"}, {"speaker": "BEA", "text": "[tiny voice, shouting] THAT'S MY BROTHER! [pause] He's a mushroom!"}, {"speaker": "PRINCIPAL", "text": "[foamy, deadpan] ...Best. Disaster. Ever."}, {"speaker": "NARRATOR", "text": "You didn't win. [pause] The girl with seven bowling pins won. [pause] Honestly? Fair."}, {"speaker": "YOU", "text": "[laughing, covered in foam] We got \"Most Unforgettable\"!"}, {"speaker": "IVY", "text": "[laughing] See? Told you! The mess-up IS the fun part!"}], "voice_segments": [{"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 0.0, "end_time_seconds": 6.96, "character_start_index": 0, "character_end_index": 92, "dialogue_input_index": 0}, {"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 6.96, "end_time_seconds": 