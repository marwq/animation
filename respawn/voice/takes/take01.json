{"id": "01", "model": "eleven_v4", "lines": [{"speaker": "NARRATOR", "text": "[excited, hushed] What if every time you messed up... you could just... respawn?"}, {"speaker": "NARRATOR", "text": "[playful] Fall off your bike? Respawn. Spill spaghetti on the principal? Respawn."}, {"speaker": "NARRATOR", "text": "[fast, playful] Get hit in the face with a dodgeball? Respawn... and catch it this time."}, {"speaker": "YOU", "text": "[cocky] Easy. Real life is just an obby... with checkpoints."}, {"speaker": "NARRATOR", "text": "[ominous] But what if you respawned... too many times?"}, {"speaker": "TIP", "text": "[glitching] T-TIP: Respawns used: nine thousand, nine hundred... and ninety-nine. [pause] That's... a lot."}, {"speaker": "YOU", "text": "[panicked] Okay, okay! Maybe I respawned a LITTLE too much!"}, {"speaker": "NARRATOR", "text": "[deadpan] Yeah. This needs some explaining. [pause] Let's go back... to the first checkpoint."}], "voice_segments": [{"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 0.0, "end_time_seconds": 3.92, "character_start_index": 0, "character_end_index": 80, "dialogue_input_index": 0}, {"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 3.92, "end_time_seconds": 9.200000000000001, "character_start_index": 80, "character_end_index": 161, "dialogue_input_index": 1}, {"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 9.200000000000001, "end_time_seconds": 13.120000000000001, "character_start_index": 161, "character_end_index": 249, "dialogue_input_index": 2}, {"voice_id": "TX3LPaxmHKxFdv7VOQHJ", "start_time_seconds": 13.120000000000001, "end_time_seconds": 17.040000000000003, "character_start_index": 249, "character_end_index": 309, "dialogue_input_index": 3}, {"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 17.040000000000003, "end_time_seconds": 20.48, "character_start_index": 309, "character_end_index": 363, "dialogue_input_index": 4}, {"voice_id": "IKne3meq5aSn9XLyUdCD", "start_time_seconds": 20.48, "end