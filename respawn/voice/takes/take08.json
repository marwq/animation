{"id": "08", "model": "eleven_v4", "lines": [{"speaker": "SYSTEM", "text": "[booming, alarm] Warning! Save file corrupted. [pause] Respawns used: nine thousand, nine hundred, ninety-nine."}, {"speaker": "NARRATOR", "text": "[ominous] And then... everything you had ever undone... came back."}, {"speaker": "TIP", "text": "[glitching] T-TIP: Those are your fails. All of them. [pause] They never went away. [pause] They were just... saved."}, {"speaker": "KID", "text": "[laughing] Look! He fell off his skateboard like a HUNDRED times!"}, {"speaker": "PRINCIPAL", "text": "[outraged] Why is a ghost throwing spaghetti at me?! [pause] AGAIN?!"}, {"speaker": "NARRATOR", "text": "Now everyone could see every mistake you had ever erased. [pause] All nine thousand, nine hundred and ninety-nine of them."}, {"speaker": "YOU", "text": "[miserable] This is my worst nightmare. [pause] Literally. I've HAD this nightmare."}, {"speaker": "IVY", "text": "[amazed, quiet] You fell fifty-six times... and you got back up fifty-six times?"}, {"speaker": "YOU", "text": "[ashamed] Only because I could respawn."}, {"speaker": "IVY", "text": "[smiling] Still. [pause] That's kind of cool."}, {"speaker": "DAD", "text": "[stuck, looping] Why did the pan\u2014 [pause] Why did the pan\u2014 [pause] Why did the pan\u2014"}, {"speaker": "BEA", "text": "[tiny voice, looping] Help! Help! Help!"}, {"speaker": "TIP", "text": "[urgent, glitching] TIP: The day is f-f-freezing! If it freezes... everyone gets stuck. FOREVER!"}], "voice_segments": [{"voice_id": "SAz9YHcvj6GT2YYXdXww", "start_time_seconds": 0.0, "end_time_seconds": 6.800000000000001, "character_start_index": 0, "character_end_index": 111, "dialogue_input_index": 0}, {"voice_id": "JBFqnCBsd6RMkjVDRZzb", "start_time_seconds": 6.800000000000001, "end_time_seconds": 11.32, "character_start_index": 111, "character_end_index": 177, "dialogue_input_index": 1}, {"voice_id": "IKne3meq5aSn9XLyUdCD", "start_time_seconds": 11.32, "end_time_seconds": 18.64, "